diff --git a/src/locales/index.ts b/src/locales/index.ts
new file mode 100644
index 0000000..87a8596
--- /dev/null
+++ b/src/locales/index.ts
@@ -0,0 +1,25 @@
+// onprem: German UI. Keys are the original English texts; missing entries fall back to English.
+// All German texts (UTF-8, umlauts) live in ./de.ts - the only non-ASCII source file of the web UI.
+import { App } from 'vue'
+import de from './de'
+
+const dict: Record<string, string> = de
+
+// t('Delete {0} files?', n) -> placeholders {0}, {1}, ... are replaced in order
+export function t (text: string, ...args: Array<string | number>): string {
+  let out = dict[text] ?? text
+  args.forEach((a, i) => { out = out.split(`{${i}}`).join(String(a)) })
+  return out
+}
+
+declare module '@vue/runtime-core' {
+  interface ComponentCustomProperties {
+    $t: typeof t
+  }
+}
+
+export default {
+  install (app: App) {
+    app.config.globalProperties.$t = t
+  },
+}
