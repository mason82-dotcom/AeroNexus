--- a/src/api/mapping.ts
+++ b/src/api/mapping.ts
@@ -82,3 +82,33 @@ export async function getMappingLayers (): Promise<MappingLayer[]> {
 export function layerTileUrl (layer: MappingLayer): string {
   return mappingBase() + layer.tile_url + '?token=' + encodeURIComponent(authToken())
 }
+
+// ---- flight routes (wayline library), read and edited copies via the mapping service
+
+export interface RouteParams {
+  height: number
+  direction: number
+  margin: number
+  overlap_h: number
+  overlap_w: number
+  speed: number
+}
+
+export interface RouteGeometry {
+  id: string
+  name: string
+  drone_model_key: string
+  template_type: string
+  editable: boolean
+  polygon: [number, number][] | null // [lon, lat]
+  params: RouteParams & { height_mode: string | null, surface_follow: boolean }
+  flight_path: [number, number, number][] // [lon, lat, height]
+}
+
+export async function getRouteGeometry (waylineId: string): Promise<RouteGeometry> {
+  return (await http.get(`/api/mapping/waylines/${waylineId}`)).data
+}
+
+export async function copyRoute (waylineId: string, body: { name: string, polygon: [number, number][], params: RouteParams }): Promise<{ id: string, name: string }> {
+  return (await http.post(`/api/mapping/waylines/${waylineId}/copy`, body)).data
+}
