+// Flight route on the shared Leaflet map: area polygon, computed flight path, polygon vertex editing.
+// One route at a time; module-level state so the page and the editor share it.
+import L from 'leaflet'
+import { reactive } from 'vue'
+import { getRoot } from '/@/root'
+import { RouteGeometry } from '/@/api/mapping'
+
+type LonLat = [number, number]
+
+export const routeState = reactive<{ route: RouteGeometry | null, editing: boolean, polygon: LonLat[] }>({
+  route: null,
+  editing: false,
+  polygon: [],
+})
+
+let group: L.LayerGroup | null = null
+let areaLayer: L.Polygon | null = null
+let pathLayer: L.Polyline | null = null
+let handles: L.LayerGroup | null = null
+
+function map (): L.Map | undefined {
+  return getRoot()?.$map?.leaflet
+}
+
+const toLatLng = (p: LonLat): L.LatLngExpression => [p[1], p[0]]
+
+function vertexIcon (): L.DivIcon {
+  return L.divIcon({ className: 'route-vertex', iconSize: [12, 12], html: '' })
+}
+
+function midIcon (): L.DivIcon {
+  return L.divIcon({ className: 'route-vertex route-vertex-mid', iconSize: [10, 10], html: '' })
+}
+
+function redrawArea () {
+  areaLayer?.setLatLngs(routeState.polygon.map(toLatLng))
+}
+
+function rebuildHandles () {
+  handles?.clearLayers()
+  if (!handles || !routeState.editing) return
+  const poly = routeState.polygon
+  poly.forEach((p, i) => {
+    const m = L.marker(toLatLng(p), { icon: vertexIcon(), draggable: true, keyboard: false, zIndexOffset: 1000 })
+    m.bindTooltip('Drag to move, right-click to delete', { direction: 'top', offset: [0, -8] })
+    m.on('drag', (e: any) => {
+      const ll = e.target.getLatLng()
+      routeState.polygon[i] = [ll.lng, ll.lat]
+      redrawArea()
+    })
+    m.on('dragend', rebuildHandles)
+    m.on('contextmenu', () => {
+      if (routeState.polygon.length <= 3) return
+      routeState.polygon.splice(i, 1)
+      redrawArea()
+      rebuildHandles()
+    })
+    handles!.addLayer(m)
+    // midpoint handle: click inserts a new vertex
+    const q = poly[(i + 1) % poly.length]
+    const mid: LonLat = [(p[0] + q[0]) / 2, (p[1] + q[1]) / 2]
+    const mm = L.marker(toLatLng(mid), { icon: midIcon(), keyboard: false, zIndexOffset: 900 })
+    mm.bindTooltip('Click to add a corner', { direction: 'top', offset: [0, -6] })
+    mm.on('click', () => {
+      routeState.polygon.splice(i + 1, 0, mid)
+      redrawArea()
+      rebuildHandles()
+    })
+    handles!.addLayer(mm)
+  })
+}
+
+export function useRouteOverlay () {
+  function clear () {
+    group?.remove()
+    group = areaLayer = pathLayer = handles = null
+    routeState.route = null
+    routeState.editing = false
+    routeState.polygon = []
+  }
+
+  function show (route: RouteGeometry, fit = true) {
+    const m = map()
+    if (!m) return
+    clear()
+    routeState.route = route
+    routeState.polygon = (route.polygon || []).map(p => [p[0], p[1]] as LonLat)
+    group = L.layerGroup().addTo(m)
+    if (routeState.polygon.length) {
+      areaLayer = L.polygon(routeState.polygon.map(toLatLng), { color: '#2d8cf0', weight: 2, fillOpacity: 0.15 })
+        .bindTooltip(route.name, { sticky: true })
+      group.addLayer(areaLayer)
+    }
+    if (route.flight_path.length) {
+      pathLayer = L.polyline(route.flight_path.map(p => [p[1], p[0]] as L.LatLngExpression), { color: '#ff9900', weight: 2 })
+      group.addLayer(pathLayer)
+      const s = route.flight_path[0]
+      group.addLayer(L.circleMarker([s[1], s[0]], { radius: 6, color: '#ffffff', fillColor: '#19be6b', fillOpacity: 1, weight: 2 })
+        .bindTooltip('Start of the computed flight path'))
+    }
+    handles = L.layerGroup().addTo(group)
+    const target = areaLayer || pathLayer
+    if (fit && target) m.fitBounds(target.getBounds(), { padding: [40, 40], maxZoom: 19 })
+  }
+
+  function startEdit () {
+    if (!routeState.route?.editable || !areaLayer) return
+    routeState.editing = true
+    // the old flight path no longer matches the edited area: Pilot 2 recomputes it
+    pathLayer?.setStyle({ color: '#999999', dashArray: '4 6', opacity: 0.6 })
+    rebuildHandles()
+  }
+
+  function cancelEdit () {
+    const route = routeState.route
+    if (route) show(route, false)
+  }
+
+  return { show, clear, startEdit, cancelEdit }
+}
