+++ b/src/api/farming.ts
@@ -0,0 +1,71 @@
+// AeroNexus Farming Guide service (zone maps, rates, exports). Same login token as the DJI backend.
+import axios from 'axios'
+import { CURRENT_CONFIG } from '/@/api/http/config'
+import { authToken } from '/@/api/mapping'
+import { ELocalStorageKey } from '/@/types/enums'
+
+export type RateUnit = 'kg/ha' | 'l/ha'
+export type ExportFormat = 'geojson' | 'shapefile' | 'kml' | 'isoxml'
+
+export interface Zone {
+  zone: number
+  color: string
+  min: number
+  max: number
+  idx_mean: number | null
+  area_ha: number
+  rate: number | null
+}
+
+export interface ZoneMap {
+  id: string
+  name: string
+  created_at: string
+  created_by: string
+  layer_id: string
+  layer_name: string
+  index: string
+  relative: boolean
+  params: { classes: number, method: 'quantile' | 'equal', cell_m: number, min_area_m2: number }
+  product: string
+  unit: RateUnit
+  zones: Zone[]
+  limits: number[]
+  valid_ha: number
+}
+
+export function farmingBase (): string {
+  return CURRENT_CONFIG.farmingURL.replace(/\/+$/, '')
+}
+
+const http = axios.create({ timeout: 60000 })
+http.interceptors.request.use(config => {
+  config.baseURL = farmingBase()
+  config.headers[ELocalStorageKey.Token] = authToken()
+  return config
+})
+
+export async function createZoneMap (body: { layer_id: string, classes: number, method: string, cell_m: number, min_area_m2: number, name?: string }): Promise<ZoneMap> {
+  return (await http.post('/api/farming/zonemaps', body)).data
+}
+
+export async function listZoneMaps (layerId: string): Promise<ZoneMap[]> {
+  return (await http.get('/api/farming/zonemaps', { params: { layer_id: layerId } })).data
+}
+
+export async function getZoneGeoJson (id: string): Promise<any> {
+  return (await http.get(`/api/farming/zonemaps/${id}/zones.geojson`)).data
+}
+
+export async function saveRates (id: string, body: { product: string, unit: RateUnit, rates: Record<string, number | null> }): Promise<ZoneMap> {
+  return (await http.put(`/api/farming/zonemaps/${id}/rates`, body)).data
+}
+
+export async function deleteZoneMap (id: string): Promise<void> {
+  await http.delete(`/api/farming/zonemaps/${id}`)
+}
+
+// download links (<a href>): the token goes into the query string
+export function exportUrl (id: string, format: ExportFormat): string {
+  return `${farmingBase()}/api/farming/zonemaps/${id}/export/${format}?token=${encodeURIComponent(authToken())}`
+}
