From 1111111111111111111111111111111111111111 Mon Sep 17 00:00:00 2001
From: AeroNexus <aeronexus@local>
Date: Wed, 14 Oct 2026 20:00:00 +0000
Subject: [PATCH] onprem: use Forst as fallback map center

---
 src/hooks/use-g-map.ts | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/hooks/use-g-map.ts b/src/hooks/use-g-map.ts
--- a/src/hooks/use-g-map.ts
+++ b/src/hooks/use-g-map.ts
@@ -5,5 +5,5 @@
 
 function envCenter (): [number, number] {
-  const raw = (import.meta.env.VITE_MAP_CENTER as string) || '10.45,51.16' // lng,lat (Germany)
+  const raw = (import.meta.env.VITE_MAP_CENTER as string) || '8.5842,49.1533' // lng,lat (Forst, 76694)
   const [lng, lat] = raw.split(',').map(Number)
   return [lng, lat]
@@ -17,6 +17,6 @@
     state.aMap = AMapShim
     state.map = new AMapShim.Map(container, {
       center: envCenter(),
-      zoom: Number(import.meta.env.VITE_MAP_ZOOM || 6),
+      zoom: Number(import.meta.env.VITE_MAP_ZOOM || 15),
     })
     state.mouseTool = new AMapShim.MouseTool(state.map)
-- 
2.47.3
