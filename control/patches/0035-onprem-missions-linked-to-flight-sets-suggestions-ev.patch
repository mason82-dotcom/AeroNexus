--- a/src/api/missions.ts
+++ b/src/api/missions.ts
@@ -8,6 +8,20 @@ export type MissionStatus = 'planned' | 'ready' | 'flown' | 'evaluated' | 'cance
 
 export interface CheckItem { key: string, label: string, done: boolean, by: string | null, at: string | null }
 
+// onprem: flight set of the mapping ingest linked to (or suggested for) a mission; camera times are local
+export interface MissionFlightSet {
+  id: string
+  drone: string
+  kind: string
+  shots: number
+  files: number
+  first_capture: string
+  last_capture: string
+  gap_min?: number // suggestions: minutes between the planned window and the flight (0 = overlapping)
+}
+
+export interface MissionJob { id: string, name: string, status: string, progress: number, flight_set: string }
+
 export interface Mission {
   id: string
   title: string
@@ -20,6 +34,10 @@ export interface Mission {
   drone_sn: string | null
   pilot: string | null
   wayline_ids: string[]
+  flight_set_ids: string[]
+  flight_sets: MissionFlightSet[]
+  suggested_sets: MissionFlightSet[]
+  jobs: MissionJob[]
   checklist: CheckItem[]
   status: MissionStatus
   created_by: string
@@ -40,9 +58,10 @@ export interface MissionInput {
 
 export interface MissionOptions {
   purposes: Record<MissionPurpose, string>
-  drones: { sn: string, name: string }[]
+  drones: { sn: string, name: string, model_key: string }[]
   pilots: string[]
-  routes: { id: string, name: string }[]
+  routes: { id: string, name: string, model_key: string, template_types: string }[]
+  models: Record<string, string> // drone model key -> name
 }
 
 const http = axios.create({ timeout: 15000 })
@@ -76,6 +95,10 @@ export async function setMissionStatus (id: string, status: MissionStatus): Prom
   return (await http.put(`/api/mapping/missions/${id}/status`, { status })).data
 }
 
+export async function setMissionFlightSets (id: string, flightSetIds: string[]): Promise<Mission> {
+  return (await http.put(`/api/mapping/missions/${id}/flight-sets`, { flight_set_ids: flightSetIds })).data
+}
+
 export async function deleteMission (id: string): Promise<void> {
   await http.delete(`/api/mapping/missions/${id}`)
 }
