diff --git a/src/api/mapping.ts b/src/api/mapping.ts
index 4b6c653..9b992d8 100644
--- a/src/api/mapping.ts
+++ b/src/api/mapping.ts
@@ -294,3 +294,33 @@ export async function getFlightSets (): Promise<FlightSet[]> {
 export async function getFlightSet (id: string): Promise<FlightSet & { file_ids: Partial<Record<MediaCategory, string[]>> }> {
   return (await http.get(`/api/mapping/flight-sets/${id}`)).data
 }
+
+// onprem: flight sets with statistics (mapping service app/mediabrowse.py)
+export type FlightClass = 'mapping' | 'oblique' | 'flight' | 'ground' | 'unknown'
+
+export interface FlightSetSummary extends FlightSet {
+  drone_name: string
+  models: string[]
+  minutes: number
+  class: FlightClass
+  ppk: boolean
+  samples: string[]
+  rel_alt_median: number | null
+  rel_alt_max: number | null
+  nadir_share: number | null
+  rtk_share: number | null
+  center: [number, number] | null
+  bbox: [number, number, number, number] | null // s, w, n, e
+}
+
+export async function getFlightSetSummary (): Promise<FlightSetSummary[]> {
+  return (await http.get('/api/mapping/flight-sets-summary')).data
+}
+
+export async function getFlightSetPositions (id: string): Promise<{ points: [number, number, string, number | null][], total: number }> {
+  return (await http.get(`/api/mapping/flight-sets/${id}/positions`)).data
+}
+
+export async function createFlightSetJob (id: string, body: { name: string, profile: MappingProfile }): Promise<{ id: string, image_count: number }> {
+  return (await http.post(`/api/mapping/flight-sets/${id}/mapping-job`, body)).data
+}
