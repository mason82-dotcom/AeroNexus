diff --git a/src/pages/page-web/projects/flight-sets.vue b/src/pages/page-web/projects/flight-sets.vue
new file mode 100644
index 0000000..05a2c09
--- /dev/null
+++ b/src/pages/page-web/projects/flight-sets.vue
@@ -0,0 +1,268 @@
+<template>
+  <div class="flight-sets">
+    <div class="head">
+      <span class="title">{{ $t('Flight sets') }}</span>
+      <a-tooltip :title="$t('Refresh')"><ReloadOutlined class="reload" :spin="loading" @click="refresh" /></a-tooltip>
+    </div>
+    <a-radio-group v-model:value="view" size="small" button-style="solid" class="views">
+      <a-radio-button value="flights">{{ $t('Flights') }} {{ counts.flights }}</a-radio-button>
+      <a-radio-button value="tests">{{ $t('Tests') }} {{ counts.tests }}</a-radio-button>
+      <a-radio-button value="all">{{ $t('All') }} {{ sets.length }}</a-radio-button>
+    </a-radio-group>
+    <div v-if="!loading && !shown.length" class="empty">{{ $t('No flight sets yet') }}</div>
+    <div v-for="s in shown" :key="s.id" class="card" :class="{ selected: selected?.id === s.id }" @click="select(s)">
+      <div class="row1">
+        <span class="when">{{ formatDay(s.first_capture) }}</span>
+        <span class="dim">{{ s.minutes >= 1 ? Math.round(s.minutes) + ' min' : '' }}</span>
+        <span class="grow"></span>
+        <a-tag :color="classColor[s.class]">{{ $t(classLabel[s.class]) }}</a-tag>
+      </div>
+      <div class="row2">
+        {{ s.drone_name || $t('unknown drone') }}
+        <span class="dim">{{ s.drone ? '…' + s.drone.slice(-5) : '' }}</span>
+        <a-tag class="kind" :color="kindColor[s.kind]">{{ $t(kindLabel[s.kind]) }}</a-tag>
+        <a-tooltip v-if="s.ppk" :title="$t('PPK raw data available: edge/ppk.sh {0} <base station folder>', [s.id.slice(0, 8)])">
+          <a-tag color="gold">PPK</a-tag>
+        </a-tooltip>
+      </div>
+      <div class="stats">
+        {{ s.shots }} {{ $t('shots') }} &#183; {{ s.files }} {{ $t('files') }}
+        <template v-if="s.class !== 'ground' && s.rel_alt_median !== null"> &#183; {{ Math.round(s.rel_alt_median) }} m</template>
+        <template v-if="s.nadir_share"> &#183; {{ Math.round(s.nadir_share * 100) }} % {{ $t('nadir') }}</template>
+      </div>
+      <div v-if="s.samples.length" class="samples">
+        <img v-for="f in s.samples" :key="f" :src="thumbnailUrl(f)" loading="lazy" alt="" />
+      </div>
+      <div v-if="selected?.id === s.id" class="actions" @click.stop>
+        <a-button size="small" @click="openMedia(s)">{{ $t('Show media') }}</a-button>
+        <a-button v-if="canMap(s)" size="small" type="primary" @click="openJob(s)">{{ $t('Mapping job') }}</a-button>
+        <a-button v-if="s.by_category.thermal" size="small" @click="openPv(s)">{{ $t('PV inspection') }}</a-button>
+        <a-button v-if="s.by_category.multispectral" size="small" @click="openMedia(s, 'multispectral')">NDVI</a-button>
+        <div v-if="s.class === 'ground'" class="note">{{ $t('Taken on the ground (0 m, camera level): not suitable for mapping.') }}</div>
+        <div v-if="positions.total" class="note">{{ positions.total }} {{ $t('positions on the map') }}</div>
+      </div>
+    </div>
+
+    <a-modal v-model:visible="job.visible" :title="$t('New mapping job')" :confirm-loading="job.busy" @ok="createJob">
+      <a-form layout="vertical">
+        <a-form-item :label="$t('Name')"><a-input v-model:value="job.name" /></a-form-item>
+        <a-form-item :label="$t('Profile')">
+          <a-select v-model:value="job.profile" :options="profileOptions" />
+        </a-form-item>
+      </a-form>
+      <p class="modal-note">{{ jobNote }}</p>
+    </a-modal>
+
+    <a-modal v-model:visible="pv.visible" :title="$t('New PV inspection')" :confirm-loading="pv.busy" @ok="createPv">
+      <a-form layout="vertical">
+        <a-form-item :label="$t('Name')"><a-input v-model:value="pv.name" /></a-form-item>
+      </a-form>
+      <p class="modal-note">{{ $t('{0} thermal images with the default parameters (emissivity 0.85, reflected temperature 23 °C, minimum difference 3 K). Details can be changed on the Photovoltaics page.', [pv.count]) }}</p>
+    </a-modal>
+  </div>
+</template>
+
+<script lang="ts" setup>
+// onprem: flight sets (ingest of the mapping service): overview, positions on the map, one-click actions
+import L from 'leaflet'
+import { computed, onMounted, onUnmounted, reactive, ref } from 'vue'
+import { useRouter } from 'vue-router'
+import { message } from 'ant-design-vue'
+import { ReloadOutlined } from '@ant-design/icons-vue'
+import { t } from '/@/locales'
+import { getRoot } from '/@/root'
+import { ERouterName } from '/@/types'
+import {
+  FlightClass, FlightSetSummary, MappingProfile, authToken, createFlightSetJob, getFlightSet,
+  getFlightSetPositions, getFlightSetSummary, mappingBase
+} from '/@/api/mapping'
+import { createInspection } from '/@/api/pv'
+
+const router = useRouter()
+const sets = ref<FlightSetSummary[]>([])
+const loading = ref(false)
+const view = ref<'flights' | 'tests' | 'all'>('flights')
+const selected = ref<FlightSetSummary | null>(null)
+const positions = reactive({ total: 0 })
+
+const classLabel: Record<FlightClass, string> = { mapping: 'Mapping flight', oblique: 'Oblique flight', flight: 'Flight', ground: 'Ground test', unknown: 'unknown' }
+const classColor: Record<FlightClass, string> = { mapping: 'green', oblique: 'cyan', flight: 'blue', ground: 'default', unknown: 'default' }
+const kindLabel: Record<string, string> = { thermal: 'Thermal', multispectral: 'Multispectral', rgb: 'RGB', video: 'Video', mixed: 'mixed' }
+const kindColor: Record<string, string> = { thermal: 'volcano', multispectral: 'purple', rgb: 'blue', video: 'default', mixed: 'default' }
+const categoryColor: Record<string, string> = { thermal: '#e8590c', visible: '#3b6fd8', rgb: '#3b6fd8', multispectral: '#9c36b5' }
+
+const isFlight = (s: FlightSetSummary) => s.class === 'mapping' || s.class === 'oblique' || s.class === 'flight'
+const counts = computed(() => ({ flights: sets.value.filter(isFlight).length, tests: sets.value.filter(s => !isFlight(s)).length }))
+const shown = computed(() => view.value === 'all' ? sets.value : sets.value.filter(s => (view.value === 'flights') === isFlight(s)))
+
+function formatDay (iso: string): string {
+  return `${iso.slice(8, 10)}.${iso.slice(5, 7)}.${iso.slice(0, 4)} ${iso.slice(11, 16)}`
+}
+function thumbnailUrl (fileId: string): string {
+  return `${mappingBase()}/api/mapping/media/${fileId}/thumbnail.jpg?token=${encodeURIComponent(authToken())}`
+}
+function canMap (s: FlightSetSummary): boolean {
+  return s.class !== 'ground' && !!(s.by_category.rgb || s.by_category.visible || s.by_category.multispectral)
+}
+
+async function refresh () {
+  loading.value = true
+  try {
+    sets.value = await getFlightSetSummary()
+    if (!counts.value.flights) view.value = 'all'
+  } catch (e) {
+    message.error(t('Flight sets not available (mapping service not reachable)'))
+  } finally {
+    loading.value = false
+  }
+}
+
+// ---------------------------------------------------------------- map: one point per shot
+let layer: L.LayerGroup | null = null
+function leaflet (): L.Map | undefined {
+  return getRoot()?.$map?.leaflet
+}
+function clearMap () {
+  layer?.remove()
+  layer = null
+  positions.total = 0
+}
+async function select (s: FlightSetSummary) {
+  if (selected.value?.id === s.id) return
+  selected.value = s
+  clearMap()
+  const map = leaflet()
+  if (!map) return
+  try {
+    const res = await getFlightSetPositions(s.id)
+    if (selected.value?.id !== s.id) return
+    positions.total = res.total
+    layer = L.layerGroup(res.points.map(([lat, lon, cat, h]) => L.circleMarker([lat, lon], {
+      radius: 3, weight: 0, fillOpacity: 0.85, fillColor: categoryColor[cat] || '#666'
+    }).bindTooltip(`${t(kindLabel[cat] || cat)}${h !== null ? ' · ' + h + ' m' : ''}`))).addTo(map)
+    if (s.bbox) {
+      map.fitBounds(L.latLngBounds([s.bbox[0], s.bbox[1]], [s.bbox[2], s.bbox[3]]), { padding: [40, 40], maxZoom: 19 })
+    }
+  } catch (e) {
+    message.warning(t('Positions not available'))
+  }
+}
+onUnmounted(clearMap)
+
+// ---------------------------------------------------------------- actions
+function openMedia (s: FlightSetSummary, category?: string) {
+  router.push({ path: '/' + ERouterName.MEDIA, query: { set: s.id.slice(0, 8), ...(category ? { category } : {}) } })
+}
+
+const job = reactive({ visible: false, busy: false, set: null as FlightSetSummary | null, name: '', profile: 'standard' as MappingProfile })
+const profileOptions = computed(() => [
+  { value: 'fast', label: t('fast (orthophoto only)') },
+  { value: 'standard', label: t('standard') },
+  { value: 'high', label: t('high (with surface model)') },
+  ...(job.set?.by_category.multispectral ? [{ value: 'multispectral', label: t('multispectral (band TIFs)') }] : [])
+])
+const jobNote = computed(() => {
+  const s = job.set
+  if (!s) return ''
+  const n = job.profile === 'multispectral' ? (s.by_category.multispectral || 0) : (s.by_category.rgb || 0) + (s.by_category.visible || 0)
+  const ppk = s.ppk ? ' ' + t('Without PPK positions (for PPK use edge/ppk.sh on the server).') : ''
+  return t('{0} photos of this flight set; the job waits until a compute node picks it up.', [n]) + ppk
+})
+function openJob (s: FlightSetSummary) {
+  job.set = s
+  job.name = `${t('Orthomosaic')} ${formatDay(s.first_capture).slice(0, 10)} (${s.drone_name || '?'})`
+  job.profile = s.kind === 'multispectral' ? 'multispectral' : 'standard'
+  job.visible = true
+}
+async function createJob () {
+  if (!job.set) return
+  job.busy = true
+  try {
+    const res = await createFlightSetJob(job.set.id, { name: job.name, profile: job.profile })
+    message.success(t('Mapping job created ({0} images)', [res.image_count]))
+    job.visible = false
+  } catch (e: any) {
+    message.error(t('Creating the job failed: ') + (e?.response?.data?.detail || e?.message || ''))
+  } finally {
+    job.busy = false
+  }
+}
+
+const pv = reactive({ visible: false, busy: false, set: null as FlightSetSummary | null, name: '', count: 0 })
+function openPv (s: FlightSetSummary) {
+  pv.set = s
+  pv.count = s.by_category.thermal || 0
+  pv.name = `${t('PV inspection')} ${formatDay(s.first_capture).slice(0, 10)} (${s.drone_name || '?'})`
+  pv.visible = true
+}
+async function createPv () {
+  if (!pv.set) return
+  pv.busy = true
+  try {
+    const detail = await getFlightSet(pv.set.id)
+    const ids = detail.file_ids.thermal || []
+    await createInspection({
+      name: pv.name, file_ids: ids, merge_m: 1.0,
+      thermal: { emissivity: 0.85, reflected_temp: 23, humidity: 70 },
+      detect: { min_delta: 3, class1: 3, class2: 10, class3: 20 }
+    })
+    message.success(t('Inspection queued'))
+    pv.visible = false
+    router.push('/' + ERouterName.PHOTOVOLTAIK)
+  } catch (e: any) {
+    message.error(t('Starting the inspection failed: ') + (e?.response?.data?.detail || e?.message || ''))
+  } finally {
+    pv.busy = false
+  }
+}
+
+onMounted(refresh)
+</script>
