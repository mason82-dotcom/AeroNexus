diff --git a/src/api/mapping.ts b/src/api/mapping.ts
index ff59870..9d815ec 100644
--- a/src/api/mapping.ts
+++ b/src/api/mapping.ts
@@ -143,6 +143,66 @@ export interface RouteParams {
   overlap_h: number
   overlap_w: number
   speed: number
+  image_format?: string | null // thermal cameras: "visable", "ir", "visable,ir"
+}
+
+export type PlanLens = 'wide' | 'thermal' | 'ms'
+
+export interface PlanPreset {
+  label: string
+  lens: PlanLens
+  gsd_cm: number
+  height: number
+  overlap_h: number
+  overlap_w: number
+  max_speed: number
+  image_format: string | null
+  hint: string
+}
+
+export interface PlanInfo {
+  id: string
+  name: string
+  camera: string
+  payload_key: string
+  params: RouteParams
+  polygon: [number, number][] | null
+  image_format: string | null
+  lenses: { key: PlanLens, label: string, gsd_cm_per_10m: number, width_px: number, height_px: number }[]
+  presets: Record<string, PlanPreset>
+  image_formats: string[]
+  legal_max_height: number
+  shot_interval_s: number
+}
+
+export interface PlanPreviewResult {
+  gsd_cm: number
+  footprint_m: [number, number]
+  line_spacing_m: number
+  lines: [[number, number], [number, number]][]
+  line_count: number
+  length_m: number
+  area_ha: number
+  duration_min: number
+  photos: number
+  warnings: string[]
+}
+
+export interface PlanTemplate { id: string, name: string, camera: string, drone_model_key: string, payload_key: string }
+
+export async function getPlanTemplates (): Promise<PlanTemplate[]> {
+  return (await http.get('/api/mapping/waylines/templates')).data
+}
+
+export async function getPlanInfo (waylineId: string): Promise<PlanInfo> {
+  return (await http.get(`/api/mapping/waylines/${waylineId}/plan-info`)).data
+}
+
+export async function planPreview (waylineId: string, body: {
+  polygon: [number, number][], lens: PlanLens, height: number, overlap_h: number, overlap_w: number,
+  direction: number, speed: number, margin: number
+}): Promise<PlanPreviewResult> {
+  return (await http.post(`/api/mapping/waylines/${waylineId}/plan-preview`, body)).data
 }
 
 export interface RouteGeometry {
