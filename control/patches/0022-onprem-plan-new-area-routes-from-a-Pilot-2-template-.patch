     routeState.polygon = []
   }
 
@@ -116,5 +119,28 @@ export function useRouteOverlay () {
     if (route) show(route, false)
   }
 
-  return { show, clear, startEdit, cancelEdit }
+  /** New area route: editable polygon (no flight path yet), preview lines drawn by showPlanLines. */
+  function startPlan (route: RouteGeometry, polygon: LonLat[]) {
+    const m = map()
+    if (!m) return
+    show({ ...route, polygon, flight_path: [], editable: true }, false)
+    routeState.planning = true
+    planLines = L.layerGroup().addTo(group as L.LayerGroup)
+    startEdit()
+    if (areaLayer) m.fitBounds(areaLayer.getBounds(), { padding: [80, 80], maxZoom: 18 })
+  }
+
+  function showPlanLines (lines: [[number, number], [number, number]][]) {
+    if (!planLines) return
+    planLines.clearLayers()
+    const pts: L.LatLngExpression[] = []
+    lines.forEach(seg => { pts.push(toLatLng(seg[0]), toLatLng(seg[1])) })
+    if (pts.length) {
+      planLines.addLayer(L.polyline(pts, { color: '#ff9900', weight: 2, dashArray: '6 4', interactive: false }))
+      planLines.addLayer(L.circleMarker(pts[0], { radius: 6, color: '#fff', fillColor: '#19be6b', fillOpacity: 1, weight: 2 })
+        .bindTooltip('Start (preview)'))
+    }
+  }
+
+  return { show, clear, startEdit, cancelEdit, startPlan, showPlanLines }
 }
