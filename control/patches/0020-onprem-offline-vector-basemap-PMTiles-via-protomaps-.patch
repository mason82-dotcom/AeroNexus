index 8cdffcd..73f1268 100644
--- a/src/vendors/amap-leaflet-shim.ts
+++ b/src/vendors/amap-leaflet-shim.ts
@@ -8,6 +8,7 @@
  */
 import L from 'leaflet'
 import 'leaflet/dist/leaflet.css'
+import { leafletLayer } from 'protomaps-leaflet'
 
 type Coord = LngLat | [number, number] | { lng: number, lat: number }
 
@@ -253,6 +254,9 @@ export class Circle extends Overlay {
 const TILE_URL = (import.meta.env.VITE_MAP_TILE_URL as string) || 'https://tile.openstreetmap.org/{z}/{x}/{y}.png'
 const TILE_ATTR = (import.meta.env.VITE_MAP_TILE_ATTRIBUTION as string) || '&copy; OpenStreetMap contributors'
 const SAT_URL = 'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}'
+// onprem: offline vector basemap (PMTiles from mapping-tool/basemaps/fetch-basemap.sh, served by the web nginx)
+const PMTILES_URL = (import.meta.env.VITE_MAP_PMTILES_URL as string) || ''
+const PMTILES_ATTR = '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>, <a href="https://protomaps.com">Protomaps</a>'
 
 export class Map {
   leaflet: L.Map
@@ -270,8 +274,19 @@ export class Map {
     el.style.zIndex = '0'
     const street = L.tileLayer(TILE_URL, { maxZoom: 20, maxNativeZoom: 19, attribution: TILE_ATTR })
     const sat = L.tileLayer(SAT_URL, { maxZoom: 20, maxNativeZoom: 19, attribution: 'Tiles &copy; Esri' })
-    street.addTo(this.leaflet)
-    L.control.layers({ Karte: street, Satellit: sat }, {}, { position: 'topright' }).addTo(this.leaflet)
+    const bases: Record<string, L.Layer> = {}
+    if (PMTILES_URL) {
+      // works without internet; outside the extracted region the map stays empty -> switch to online
+      const offline = leafletLayer({ url: PMTILES_URL, flavor: 'light', lang: 'de', maxDataZoom: 15,
+        attribution: PMTILES_ATTR }) as unknown as L.Layer
+      bases['Offline-Karte'] = offline
+      offline.addTo(this.leaflet)
+    } else {
+      street.addTo(this.leaflet)
+    }
+    bases[PMTILES_URL ? 'Karte (online)' : 'Karte'] = street
+    bases[PMTILES_URL ? 'Satellit (online)' : 'Satellit'] = sat
+    L.control.layers(bases, {}, { position: 'topright' }).addTo(this.leaflet)
     L.control.scale({ imperial: false }).addTo(this.leaflet)
   }
 
