diff --git a/src/api/status.ts b/src/api/status.ts
new file mode 100644
index 0000000..680a83f
--- /dev/null
+++ b/src/api/status.ts
@@ -0,0 +1,59 @@
+// onprem: status page (mapping service app/status.py; host data from edge/status.sh)
+import axios from 'axios'
+import { authToken, mappingBase } from '/@/api/mapping'
+import { ELocalStorageKey } from '/@/types/enums'
+
+export interface ServiceState { name: string, label: string, ok: boolean, detail: string, ms: number }
+export interface DiskState {
+  name: 'system' | 'minio' | 'backup'
+  path: string
+  exists: boolean
+  total?: number
+  free?: number
+  used?: number
+  device?: string
+  mount?: string
+}
+export interface HostState {
+  at: string
+  age_s: number | null
+  hostname: string
+  uptime_s: number
+  load: number[]
+  cpu_count: number
+  temp_c: number | null
+  mem_total: number | null
+  mem_available: number | null
+  disks: DiskState[]
+  backup: { dir: string, last_success: string | null, summary: string[], dumps: number, latest_dump: string | null, cron: boolean }
+  containers: { service: string, state: string, health: string, exit_code: number | null, status: string }[]
+}
+export interface StatusWarning { level: 'error' | 'warning' | 'info', key: string, text: string, link: string | null }
+export interface StatusJob { id: string, name: string, status: string, progress: number, message: string | null, agent_id: string | null, created_at: string }
+export interface SystemStatus {
+  now: string
+  services: ServiceState[]
+  host: HostState | null
+  agents: { agent_id: string, last_seen: string, age_s: number, capabilities: Record<string, unknown> }[]
+  jobs: { counts: Record<string, number>, active: StatusJob[], failed_recent: { id: string, name: string, message: string | null, updated_at: string }[] }
+  today: {
+    missions: { id: string, title: string, purpose: string, planned_start: string, status: string, drone_sn: string | null, pilot: string | null }[]
+    to_evaluate: number
+    uploads_24h: number
+    uploads_by_drone: { drone: string, name: string, files: number }[]
+    last_upload: string | null
+    flight_sets_24h: { id: string, drone: string, drone_name: string, kind: string, shots: number, first_capture: string, uploaded: number }[]
+  }
+  warnings: StatusWarning[]
+}
+
+const http = axios.create({ timeout: 20000 })
+http.interceptors.request.use(config => {
+  config.baseURL = mappingBase()
+  config.headers[ELocalStorageKey.Token] = authToken()
+  return config
+})
+
+export async function getSystemStatus (): Promise<SystemStatus> {
+  return (await http.get('/api/mapping/status')).data
+}
