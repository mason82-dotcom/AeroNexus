+// AeroNexus mapping service (mapping-tool/service). Uses the same login token as the DJI backend.
+import axios from 'axios'
+import { CURRENT_CONFIG } from '/@/api/http/config'
+import { ELocalStorageKey } from '/@/types/enums'
+
+export type MappingProfile = 'fast' | 'standard' | 'high'
+
+export interface MappingMedia {
+  file_id: string
+  file_name: string
+  object_key: string
+  drone: string
+  payload: string
+  is_original: boolean
+  create_time: string
+}
+
+export interface MappingJob {
+  id: string
+  name: string
+  status: 'QUEUED' | 'CLAIMED' | 'RUNNING' | 'DONE' | 'FAILED'
+  image_count: number
+  options: { profile: MappingProfile, odm: Record<string, unknown> }
+  created_by: string
+  agent_id: string | null
+  lease_until: string | null
+  attempts: number
+  progress: number
+  message: string | null
+  error: string | null
+  created_at: string
+  finished_at: string | null
+}
+
+export interface MappingLayer {
+  id: string
+  job_id: string | null
+  name: string
+  type: string
+  format: string
+  min_zoom: number
+  max_zoom: number
+  bounds_wgs84: [number, number, number, number] | null
+  opacity: number
+  attribution: string | null
+  created_at: string
+  tile_url: string
+}
+
+export function mappingBase (): string {
+  return CURRENT_CONFIG.mappingURL.replace(/\/+$/, '')
+}
+
+export function authToken (): string {
+  return localStorage.getItem(ELocalStorageKey.Token) || ''
+}
+
+const http = axios.create({ timeout: 15000 })
+http.interceptors.request.use(config => {
+  config.baseURL = mappingBase()
+  config.headers[ELocalStorageKey.Token] = authToken()
+  return config
+})
+
+export async function getMappingMedia (page = 1, pageSize = 200): Promise<{ total: number, list: MappingMedia[] }> {
+  return (await http.get('/api/mapping/media', { params: { page, page_size: pageSize } })).data
+}
+
+export async function getMappingJobs (): Promise<MappingJob[]> {
+  return (await http.get('/api/mapping/jobs')).data
+}
+
+export async function createMappingJob (body: { name: string, image_keys: string[], profile: MappingProfile }): Promise<MappingJob> {
+  return (await http.post('/api/mapping/jobs', body)).data
+}
+
+export async function getMappingLayers (): Promise<MappingLayer[]> {
+  return (await http.get('/api/mapping/layers')).data
+}
+
+// Leaflet loads tiles via <img>, so the token goes into the query string
+export function layerTileUrl (layer: MappingLayer): string {
+  return mappingBase() + layer.tile_url + '?token=' + encodeURIComponent(authToken())
+}
