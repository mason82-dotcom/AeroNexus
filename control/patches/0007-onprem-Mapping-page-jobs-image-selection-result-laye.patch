diff --git a/src/hooks/use-mapping-layers.ts b/src/hooks/use-mapping-layers.ts
new file mode 100644
index 0000000..103ac68
--- /dev/null
+++ b/src/hooks/use-mapping-layers.ts
@@ -0,0 +1,69 @@
+// Result layers of the mapping service as Leaflet tile layers on the shared map.
+// Kept at module level so layers stay on the map when the Mapping page is left.
+import L from 'leaflet'
+import { reactive } from 'vue'
+import { getRoot } from '/@/root'
+import { MappingLayer, layerTileUrl } from '/@/api/mapping'
+
+const active = new Map<string, L.TileLayer>()
+export const layerState = reactive<{ visible: Record<string, boolean>, opacity: Record<string, number> }>({
+  visible: {},
+  opacity: {},
+})
+
+function leafletMap (): L.Map | undefined {
+  return getRoot()?.$map?.leaflet
+}
+
+function bounds (layer: MappingLayer): L.LatLngBounds | undefined {
+  if (!layer.bounds_wgs84) return undefined
+  const [w, s, e, n] = layer.bounds_wgs84
+  return L.latLngBounds([s, w], [n, e])
+}
+
+export function useMappingLayers () {
+  function show (layer: MappingLayer) {
+    const map = leafletMap()
+    if (!map || active.has(layer.id)) return
+    const opacity = layerState.opacity[layer.id] ?? layer.opacity
+    const tiles = L.tileLayer(layerTileUrl(layer), {
+      opacity,
+      minNativeZoom: layer.min_zoom,
+      maxNativeZoom: layer.max_zoom,
+      maxZoom: 22,
+      bounds: bounds(layer),
+      attribution: layer.attribution || '',
+      zIndex: 300, // above the base map (Karte/Satellit), below markers
+    })
+    tiles.addTo(map)
+    active.set(layer.id, tiles)
+    layerState.visible[layer.id] = true
+    layerState.opacity[layer.id] = opacity
+  }
+
+  function hide (id: string) {
+    const tiles = active.get(id)
+    if (tiles) tiles.remove()
+    active.delete(id)
+    layerState.visible[id] = false
+  }
+
+  function toggle (layer: MappingLayer, visible: boolean) {
+    visible ? show(layer) : hide(layer.id)
+  }
+
+  function setOpacity (id: string, opacity: number) {
+    layerState.opacity[id] = opacity
+    active.get(id)?.setOpacity(opacity)
+  }
+
+  function zoomTo (layer: MappingLayer) {
+    const b = bounds(layer)
+    const map = leafletMap()
+    if (!b || !map) return
+    if (!active.has(layer.id)) show(layer)
+    map.fitBounds(b, { maxZoom: layer.max_zoom })
+  }
+
+  return { show, hide, toggle, setOpacity, zoomTo }
+}
diff --git a/src/pages/page-web/projects/mapping.vue b/src/pages/page-web/projects/mapping.vue
new file mode 100644
index 0000000..bc60e63
--- /dev/null
+++ b/src/pages/page-web/projects/mapping.vue
@@ -0,0 +1,212 @@
+<template>
+  <div class="mapping-wrapper height-100">
+    <Title title="Mapping" />
+    <div class="mapping-content uranus-scrollbar">
+      <!-- result layers -->
+      <div class="section">
+        <div class="section-head">
+          <span>Result layers</span>
+          <a @click="refresh"><ReloadOutlined /></a>
+        </div>
+        <div v-if="!layers.length" class="hint">No results yet.</div>
+        <div v-for="layer in layers" :key="layer.id" class="layer-item">
+          <div class="row">
+            <a-switch size="small" :checked="!!layerState.visible[layer.id]" @change="(v) => toggle(layer, v)" />
+            <span class="name" :title="layer.name">{{ layer.name }}</span>
+            <a v-if="layer.bounds_wgs84" title="Zoom to result" @click="zoomTo(layer)"><AimOutlined /></a>
+          </div>
+          <div class="row">
+            <span class="label">Opacity</span>
+            <a-slider class="slider" :min="0" :max="1" :step="0.05"
+                      :value="layerState.opacity[layer.id] ?? layer.opacity"
+                      @change="(v) => setOpacity(layer.id, v)" />
+          </div>
+        </div>
+      </div>
+
+      <!-- jobs -->
+      <div class="section">
+        <div class="section-head">
+          <span>Jobs</span>
+          <a-button size="small" type="primary" @click="openCreate">New job</a-button>
+        </div>
+        <div v-if="!jobs.length" class="hint">No jobs. Processing runs on the x64 compute node.</div>
+        <div v-for="job in jobs" :key="job.id" class="job-item">
+          <div class="row">
+            <span class="name" :title="job.name">{{ job.name }}</span>
+            <a-tag :color="statusColor[job.status]">{{ job.status }}</a-tag>
+          </div>
+          <a-progress v-if="job.status === 'RUNNING' || job.status === 'CLAIMED'" :percent="Math.round(job.progress)" size="small" />
+          <div class="meta">
+            {{ job.image_count }} images, {{ job.options.profile }}<span v-if="job.agent_id">, {{ job.agent_id }}</span>
+            <span v-if="job.attempts">, {{ job.attempts }} expired lease(s)</span>
+          </div>
+          <div v-if="job.message && job.status !== 'DONE'" class="meta">{{ job.message }}</div>
+          <div v-if="job.error" class="error">{{ job.error }}</div>
+        </div>
+      </div>
+    </div>
+
+    <a-modal v-model:visible="createVisible" title="New mapping job" :confirm-loading="creating"
+             ok-text="Create" :ok-button-props="{ disabled: !canCreate }" width="640px" @ok="submit">
+      <a-form layout="vertical">
+        <a-form-item label="Name">
+          <a-input v-model:value="form.name" :maxlength="200" placeholder="e.g. Halle Nord 2026-10-02" />
+        </a-form-item>
+        <a-form-item label="Profile">
+          <a-radio-group v-model:value="form.profile">
+            <a-radio-button value="fast">Fast</a-radio-button>
+            <a-radio-button value="standard">Standard</a-radio-button>
+            <a-radio-button value="high">High</a-radio-button>
+          </a-radio-group>
+        </a-form-item>
+        <a-form-item :label="`Images (${form.keys.length} selected of ${media.length})`">
+          <div class="media-tools">
+            <a @click="selectAll">All</a> <a @click="selectRgb">RGB only</a> <a @click="form.keys = []">None</a>
+          </div>
+          <a-table size="small" :pagination="false" :scroll="{ y: 320 }" row-key="object_key"
+                   :columns="mediaColumns" :data-source="media" :loading="mediaLoading"
+                   :row-selection="{ selectedRowKeys: form.keys, onChange: (keys) => form.keys = keys }" />
+        </a-form-item>
+      </a-form>
+    </a-modal>
+  </div>
+</template>
+
+<script lang="ts" setup>
+import { computed, onMounted, onUnmounted, reactive, ref } from 'vue'
+import { message } from 'ant-design-vue'
+import { AimOutlined, ReloadOutlined } from '@ant-design/icons-vue'
+import Title from '/@/components/workspace/Title.vue'
+import {
+  MappingJob, MappingLayer, MappingMedia, MappingProfile,
+  createMappingJob, getMappingJobs, getMappingLayers, getMappingMedia,
+} from '/@/api/mapping'
+import { layerState, useMappingLayers } from '/@/hooks/use-mapping-layers'
+
+const { toggle, setOpacity, zoomTo } = useMappingLayers()
+
+const jobs = ref<MappingJob[]>([])
+const layers = ref<MappingLayer[]>([])
+const media = ref<MappingMedia[]>([])
+const mediaLoading = ref(false)
+const createVisible = ref(false)
+const creating = ref(false)
+const form = reactive<{ name: string, profile: MappingProfile, keys: string[] }>({ name: '', profile: 'standard', keys: [] })
+
+const statusColor: Record<string, string> = {
+  QUEUED: 'default', CLAIMED: 'blue', RUNNING: 'processing', DONE: 'success', FAILED: 'error',
+}
+const mediaColumns = [
+  { title: 'File', dataIndex: 'file_name', ellipsis: true },
+  { title: 'Camera', dataIndex: 'payload', width: 150, ellipsis: true },
+  { title: 'Time (UTC)', dataIndex: 'create_time', width: 170, customRender: ({ text }: { text: string }) => text.replace('T', ' ').replace('Z', '') },
+]
+const canCreate = computed(() => form.name.trim().length > 0 && form.keys.length > 0)
+
+async function refresh () {
+  try {
+    const [j, l] = await Promise.all([getMappingJobs(), getMappingLayers()])
+    jobs.value = j
+    layers.value = l
+  } catch (e) {
+    message.error('Mapping service not reachable')
+  }
+}
+
+async function openCreate () {
+  createVisible.value = true
+  form.name = ''
+  form.keys = []
+  mediaLoading.value = true
+  try {
+    media.value = (await getMappingMedia()).list
+  } finally {
+    mediaLoading.value = false
+  }
+}
+
+function selectAll () {
+  form.keys = media.value.map(m => m.object_key)
+}
+
+// photogrammetry needs the visible/RGB images, not thermal (_T), multispectral (_MS_) or zoom
+function selectRgb () {
+  form.keys = media.value.filter(m => /_(D|V|W)\.(jpe?g)$/i.test(m.file_name)).map(m => m.object_key)
+}
+
+async function submit () {
+  creating.value = true
+  try {
+    await createMappingJob({ name: form.name.trim(), image_keys: form.keys, profile: form.profile })
+    message.success('Job queued')
+    createVisible.value = false
+    await refresh()
+  } catch (e: any) {
+    message.error('Creating the job failed: ' + (e?.response?.data?.detail ? JSON.stringify(e.response.data.detail) : e))
+  } finally {
+    creating.value = false
+  }
+}
+
+let timer: number | undefined
+onMounted(() => {
+  refresh()
+  timer = window.setInterval(refresh, 10000)
+})
+onUnmounted(() => window.clearInterval(timer))
+</script>
+
+<style lang="scss" scoped>
+.mapping-wrapper {
+  display: flex;
+  flex-direction: column;
+}
+.mapping-content {
+  flex: 1;
+  overflow-y: auto;
+  padding: 0 10px 10px;
+}
+.section {
+  margin-top: 10px;
+}
+.section-head {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  font-weight: 600;
+  margin-bottom: 6px;
+}
+.layer-item, .job-item {
+  background: #3c3c3c;
+  border-radius: 4px;
+  padding: 6px 8px;
+  margin-bottom: 6px;
+}
+.row {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+.name {
+  flex: 1;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.label, .meta, .hint {
+  font-size: 12px;
+  color: #aaa;
+}
+.slider {
+  flex: 1;
+}
+.error {
+  font-size: 12px;
+  color: #ff7875;
+  word-break: break-word;
+}
+.media-tools a {
+  margin-right: 12px;
+}
+</style>
