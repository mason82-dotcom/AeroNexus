From 27b3fb9ad5a8c08e0b134728f004ada7af6536bc Mon Sep 17 00:00:00 2001
From: RomaN <mason82.rm@googlemail.com>
Date: Fri, 2 Oct 2026 21:57:00 +0200
Subject: [PATCH] onprem: livestream players send the web login to MediaMTX

---
 src/vendors/live-player.ts | 21 ++++++++++++++++-----
 src/vendors/whep-player.ts | 12 ++++++++++--
 2 files changed, 26 insertions(+), 7 deletions(-)

diff --git a/src/vendors/live-player.ts b/src/vendors/live-player.ts
index 7df1961..66956a7 100644
--- a/src/vendors/live-player.ts
+++ b/src/vendors/live-player.ts
@@ -5,7 +5,8 @@
  * DJI Pilot 2 pushes H.264 over RTMP; MediaMTX does not transcode.
  */
 import Hls from 'hls.js'
-import { WhepPlayer, toWhepUrl } from './whep-player'
+import { ELocalStorageKey } from '/@/types/enums'
+import { WhepPlayer, liveAuthHeaders, toWhepUrl } from './whep-player'
 
 export type LiveMode = 'webrtc' | 'hls'
 
@@ -59,8 +60,12 @@ export class LivePlayer {
     for (let i = 1; i <= 25; i++) {
       if (token !== this.session) return // closed or restarted meanwhile
       try {
-        const res = await fetch(url, { cache: 'no-store' })
+        const res = await fetch(url, { cache: 'no-store', headers: liveAuthHeaders() })
         if (res.ok) break
+        if (res.status === 401) {
+          state('HLS: not allowed to watch (login expired? log in again)')
+          return
+        }
       } catch (_) { /* server not reachable yet */ }
       state(`HLS: waiting for stream (${i}/25)`)
       await new Promise(resolve => setTimeout(resolve, 1500))
@@ -73,7 +78,12 @@ export class LivePlayer {
     this.mode = 'hls'
     video.muted = true
     if (Hls.isSupported()) {
-      const hls = new Hls({ lowLatencyMode: true, liveSyncDurationCount: 2 })
+      const headers = liveAuthHeaders()
+      const hls = new Hls({
+        lowLatencyMode: true,
+        liveSyncDurationCount: 2,
+        xhrSetup: (xhr) => Object.entries(headers).forEach(([k, v]) => xhr.setRequestHeader(k, v)),
+      })
       this.hls = hls
       let recoveries = 0
       hls.on(Hls.Events.MANIFEST_PARSED, () => {
@@ -98,8 +108,9 @@ export class LivePlayer {
       hls.loadSource(url)
       hls.attachMedia(video)
     } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
-      // Safari / iOS: native HLS
-      video.src = url
+      // Safari / iOS: native HLS cannot send headers -> login as query parameter
+      const token = localStorage.getItem(ELocalStorageKey.Token)
+      video.src = token ? `${url}?jwt=${encodeURIComponent(token)}` : url
       video.play().catch(() => undefined)
       state('HLS (native): playing')
     } else {
diff --git a/src/vendors/whep-player.ts b/src/vendors/whep-player.ts
index f349386..dddc0a0 100644
--- a/src/vendors/whep-player.ts
+++ b/src/vendors/whep-player.ts
@@ -5,6 +5,7 @@
  * The drone needs a few seconds after "live_start_push" before the stream exists,
  * so play() retries while the server answers 404.
  */
+import { ELocalStorageKey } from '/@/types/enums'
 
 export interface WhepOptions {
   retries?: number // attempts while the stream is not yet published
@@ -14,6 +15,12 @@ export interface WhepOptions {
 
 const sleep = (ms: number) => new Promise(resolve => setTimeout(resolve, ms))
 
+// MediaMTX asks the mapping service whether this login may watch (app/mediaauth.py)
+export function liveAuthHeaders (): Record<string, string> {
+  const token = localStorage.getItem(ELocalStorageKey.Token)
+  return token ? { Authorization: `Bearer ${token}` } : {}
+}
+
 export class WhepPlayer {
   private pc: RTCPeerConnection | null = null
   private resource: string | null = null
@@ -34,6 +41,7 @@ export class WhepPlayer {
       } catch (e: any) {
         this.teardownPc()
         if (e?.status !== 404) { // 404 = path exists but nothing is published yet
+          if (e?.status === 401) e.message = 'not allowed to watch (login expired? log in again)'
           state('error: ' + (e?.message || e))
           throw e
         }
@@ -64,7 +72,7 @@ export class WhepPlayer {
 
     const res = await fetch(whepUrl, {
       method: 'POST',
-      headers: { 'Content-Type': 'application/sdp' },
+      headers: { 'Content-Type': 'application/sdp', ...liveAuthHeaders() },
       body: pc.localDescription!.sdp,
     })
     if (res.status !== 201 && res.status !== 200) {
@@ -104,7 +112,7 @@ export class WhepPlayer {
   close () {
     this.closed = true
     if (this.resource) {
-      fetch(this.resource, { method: 'DELETE' }).catch(() => undefined)
+      fetch(this.resource, { method: 'DELETE', headers: liveAuthHeaders() }).catch(() => undefined)
       this.resource = null
     }
     this.teardownPc()
-- 
2.47.3

