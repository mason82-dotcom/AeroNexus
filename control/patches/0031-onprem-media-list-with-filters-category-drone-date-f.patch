+// onprem: filter state shared by the media filter panel (left) and the media table (right)
+import { reactive } from 'vue'
+import { FlightSet, MediaCategory, MediaFacets, MediaFilter, getFlightSets, getMediaFacets } from '/@/api/mapping'
+
+export const CATEGORY_LABELS: Record<MediaCategory, string> = {
+  thermal: 'Thermal', visible: 'Visible (thermal pair)', rgb: 'RGB', multispectral: 'Multispectral',
+  video: 'Video', panorama: 'Panorama', other: 'Other'
+}
+export const CATEGORY_COLORS: Record<MediaCategory, string> = {
+  thermal: 'volcano', visible: 'geekblue', rgb: 'blue', multispectral: 'purple', video: 'default', panorama: 'cyan', other: 'default'
+}
+
+export function emptyFilter (): MediaFilter {
+  return { category: [], drone: '', flight_set: '', date_from: '', date_to: '', q: '' }
+}
+
+export const mediaFilter = reactive<MediaFilter>(emptyFilter())
+
+export function resetFilter () {
+  Object.assign(mediaFilter, emptyFilter())
+}
+
+export function shortSerial (serial: string): string {
+  return serial ? '…' + serial.slice(-5) : ''
+}
+
+// filter values (categories, drones, date span) and the flight sets, loaded once per page visit
+
+export const facets = reactive<{ data: MediaFacets | null, sets: FlightSet[] }>({ data: null, sets: [] })
+
+export async function loadFacets (): Promise<void> {
+  const [f, sets] = await Promise.all([getMediaFacets(), getFlightSets()])
+  facets.data = f
+  facets.sets = sets
+}
+
+export function droneName (serial: string): string {
+  return facets.data?.drones.find(d => d.serial === serial)?.name || ''
+}
