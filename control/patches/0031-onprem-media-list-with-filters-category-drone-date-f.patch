--- a/src/api/mapping.ts
+++ b/src/api/mapping.ts
@@ -227,3 +227,70 @@ export interface RoutePathInfo { waypoints: number, lanes: number, length_m: num
 export async function copyRoute (waylineId: string, body: { name: string, polygon: [number, number][], params: RouteParams }): Promise<{ id: string, name: string, path: RoutePathInfo | null }> {
   return (await http.post(`/api/mapping/waylines/${waylineId}/copy`, body)).data
 }
+
+// onprem: media list with ingest information and filters (mapping service app/mediabrowse.py)
+export type MediaCategory = 'thermal' | 'visible' | 'rgb' | 'multispectral' | 'video' | 'panorama' | 'other'
+
+export interface BrowseMedia {
+  file_id: string
+  file_name: string
+  object_key: string
+  file_path: string
+  payload: string
+  is_original: boolean
+  drone: string // aircraft serial from the photo, else what Pilot 2 reported
+  pilot_drone: string
+  category: MediaCategory | null
+  band: string | null
+  flight_set_id: string | null
+  captured_at: string | null // local camera time
+  uploaded_at: string
+}
+
+export interface MediaFilter {
+  category: MediaCategory[]
+  drone: string // serial, '-' = none, '' = all
+  flight_set: string
+  date_from: string // YYYY-MM-DD
+  date_to: string
+  q: string
+}
+
+export interface MediaFacets {
+  categories: Partial<Record<MediaCategory, number>>
+  drones: { serial: string, name: string, known_device: boolean, files: number, first: string | null, last: string | null }[]
+  first: string | null
+  last: string | null
+}
+
+export interface FlightSet {
+  id: string
+  drone: string
+  kind: 'thermal' | 'multispectral' | 'rgb' | 'video' | 'mixed'
+  first_capture: string
+  last_capture: string
+  shots: number
+  files: number
+  by_category: Partial<Record<MediaCategory, number>>
+}
+
+export async function browseMedia (filter: MediaFilter, page: number, pageSize: number): Promise<{ total: number, list: BrowseMedia[] }> {
+  const params: Record<string, string | number> = { page, page_size: pageSize }
+  if (filter.category.length) params.category = filter.category.join(',')
+  for (const k of ['drone', 'flight_set', 'date_from', 'date_to', 'q'] as const) {
+    if (filter[k]) params[k] = filter[k]
+  }
+  return (await http.get('/api/mapping/media/browse', { params })).data
+}
+
+export async function getMediaFacets (): Promise<MediaFacets> {
+  return (await http.get('/api/mapping/media/facets')).data
+}
+
+export async function getFlightSets (): Promise<FlightSet[]> {
+  return (await http.get('/api/mapping/flight-sets')).data
+}
+
+export async function getFlightSet (id: string): Promise<FlightSet & { file_ids: Partial<Record<MediaCategory, string[]>> }> {
+  return (await http.get(`/api/mapping/flight-sets/${id}`)).data
+}
