+    </div>
+    <div class="section">
+      <div class="label">{{ $t('Captured') }}</div>
+      <a-range-picker class="full" :value="range" format="DD.MM.YYYY" :allow-clear="true" @change="onRange" />
+    </div>
+    <div class="section">
+      <div class="label">{{ $t('Flight set') }}</div>
+      <a-select v-model:value="mediaFilter.flight_set" class="full" show-search :options="setOptions"
+                :filter-option="filterSet" :dropdown-match-select-width="false" />
+    </div>
+    <a-button v-if="active" block ghost @click="resetFilter()">{{ $t('Reset filters') }}</a-button>
+    <p class="hint">{{ $t('Drone and category come from the photo itself (aircraft serial, camera model), not from what Pilot 2 reported.') }}</p>
   </div>
 </template>
 
 <script lang="ts" setup>
+// onprem: media filters (left column); the table on the right reacts to the shared mediaFilter
+import moment, { Moment } from 'moment'
+import { computed, onMounted } from 'vue'
+import { useRoute } from 'vue-router'
+import { message } from 'ant-design-vue'
+import { t } from '/@/locales'
+import { MediaCategory } from '/@/api/mapping'
+import {
+  CATEGORY_LABELS, emptyFilter, facets, loadFacets, mediaFilter, resetFilter, shortSerial
+} from '/@/components/media/media-filter'
+
+const route = useRoute()
+const categories = computed(() => (Object.keys(CATEGORY_LABELS) as MediaCategory[])
+  .filter(c => facets.data?.categories[c] || mediaFilter.category.includes(c)))
+
+const droneOptions = computed(() => [
+  { value: '', label: t('All drones') },
+  ...(facets.data?.drones || []).map(d => ({
+    value: d.serial || '-',
+    label: d.serial ? `${d.name || t('unknown')} ${shortSerial(d.serial)} (${d.files})` : `${t('without drone')} (${d.files})`
+  }))
+])
+
+function setLabel (s: typeof facets.sets[number]): string {
+  const day = s.first_capture.slice(0, 10).split('-').reverse().join('.')
+  const name = facets.data?.drones.find(d => d.serial === s.drone)?.name || shortSerial(s.drone) || '-'
+  return `${day} ${s.first_capture.slice(11, 16)} · ${t(s.kind)} · ${name} · ${s.files} ${t('files')}`
+}
+const setOptions = computed(() => [
+  { value: '', label: t('All flight sets') },
+  ...facets.sets.map(s => ({ value: s.id.slice(0, 8), label: setLabel(s) }))
+])
+function filterSet (input: string, option: { label: string }) {
+  return option.label.toLowerCase().includes(input.toLowerCase())
+}
+
+const range = computed(() => mediaFilter.date_from && mediaFilter.date_to
+  ? [moment(mediaFilter.date_from), moment(mediaFilter.date_to)] : [])
+function onRange (dates: Moment[] | null) {
+  mediaFilter.date_from = dates && dates[0] ? dates[0].format('YYYY-MM-DD') : ''
+  mediaFilter.date_to = dates && dates[1] ? dates[1].format('YYYY-MM-DD') : ''
+}
+
+const active = computed(() => JSON.stringify(mediaFilter) !== JSON.stringify(emptyFilter()))
+
+onMounted(() => {
+  // deep links from the flight set page: /media?set=<id prefix>&category=thermal
+  const q = route.query
+  if (typeof q.set === 'string') { resetFilter(); mediaFilter.flight_set = q.set.slice(0, 8) }
+  if (typeof q.category === 'string') {
+    mediaFilter.category = q.category.split(',').filter(c => c in CATEGORY_LABELS) as MediaCategory[]
+  }
+  if (!facets.data) loadFacets().catch(() => message.warning(t('Filter values not available (mapping service not reachable)')))
+})
 </script>
 
