@@ -0,0 +1,85 @@
+// Mission planning (mapping service, app/missions.py). Same login token as the DJI backend.
+import axios from 'axios'
+import { authToken, mappingBase } from '/@/api/mapping'
+import { ELocalStorageKey } from '/@/types/enums'
+
+export type MissionPurpose = 'pv' | 'farming' | 'mapping' | 'other'
+export type MissionStatus = 'planned' | 'ready' | 'flown' | 'evaluated' | 'cancelled'
+
+export interface CheckItem { key: string, label: string, done: boolean, by: string | null, at: string | null }
+
+export interface Mission {
+  id: string
+  title: string
+  purpose: MissionPurpose
+  purpose_label: string
+  planned_start: string // ISO UTC
+  duration_min: number | null
+  site: string
+  notes: string
+  drone_sn: string | null
+  pilot: string | null
+  wayline_ids: string[]
+  checklist: CheckItem[]
+  status: MissionStatus
+  created_by: string
+  status_at: string | null
+}
+
+export interface MissionInput {
+  title: string
+  purpose: MissionPurpose
+  planned_start: string
+  duration_min: number | null
+  site: string
+  notes: string
+  drone_sn: string | null
+  pilot: string | null
+  wayline_ids: string[]
+}
+
+export interface MissionOptions {
+  purposes: Record<MissionPurpose, string>
+  drones: { sn: string, name: string }[]
+  pilots: string[]
+  routes: { id: string, name: string }[]
+}
+
+const http = axios.create({ timeout: 15000 })
+http.interceptors.request.use(config => {
+  config.baseURL = mappingBase()
+  config.headers[ELocalStorageKey.Token] = authToken()
+  return config
+})
+
+export async function missionOptions (): Promise<MissionOptions> {
+  return (await http.get('/api/mapping/missions/options')).data
+}
+
+export async function listMissions (params: { start?: string, end?: string, mine?: boolean } = {}): Promise<Mission[]> {
+  return (await http.get('/api/mapping/missions', { params })).data
+}
+
+export async function createMission (body: MissionInput): Promise<Mission> {
+  return (await http.post('/api/mapping/missions', body)).data
+}
+
+export async function updateMission (id: string, body: MissionInput): Promise<Mission> {
+  return (await http.put(`/api/mapping/missions/${id}`, body)).data
+}
+
+export async function tickCheck (id: string, key: string, done: boolean): Promise<Mission> {
+  return (await http.put(`/api/mapping/missions/${id}/checklist/${key}`, { done })).data
+}
+
+export async function setMissionStatus (id: string, status: MissionStatus): Promise<Mission> {
+  return (await http.put(`/api/mapping/missions/${id}/status`, { status })).data
+}
+
+export async function deleteMission (id: string): Promise<void> {
+  await http.delete(`/api/mapping/missions/${id}`)
+}
+
+export const STATUS_COLORS: Record<MissionStatus, string> = {
+  planned: 'blue', ready: 'green', flown: 'purple', evaluated: 'default', cancelled: 'red',
+}
diff --git a/src/components/pilot/PilotMissions.vue b/src/components/pilot/PilotMissions.vue
new file mode 100644
