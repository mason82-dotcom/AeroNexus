+<template>
+  <div class="missions-wrapper height-100">
+    <Title :title="$t('Task Plan Library')" />
+    <div class="missions-content uranus-scrollbar">
+      <div class="head">
+        <span class="hint">{{ $t('Missions for remote controller flights: plan, check, fly, evaluate.') }}</span>
+        <span>
+          <a class="reload" @click="refresh"><ReloadOutlined /></a>
+          <a-button size="small" type="primary" @click="openForm()">{{ $t('New mission') }}</a-button>
+        </span>
+      </div>
+
+      <div v-for="group in groups" :key="group.key" class="section">
+        <div class="section-head">{{ $t(group.label) }} <span class="count">{{ group.items.length }}</span></div>
+        <div v-if="!group.items.length" class="hint">{{ $t('None') }}</div>
+        <div v-for="m in group.items" :key="m.id" class="item" :class="{ open: openId === m.id }">
+          <div class="row" @click="toggle(m)">
+            <span class="time">{{ fmtTime(m.planned_start, group.key !== 'today') }}</span>
+            <span class="name" :title="m.title">{{ m.title }}</span>
+            <a-tag :color="STATUS_COLORS[m.status]" class="tag">{{ $t(statusText[m.status]) }}</a-tag>
+          </div>
+          <div class="meta">
+            {{ m.purpose_label }}<span v-if="m.site"> &#183; {{ m.site }}</span>
+            <span v-if="m.drone_sn"> &#183; {{ droneName(m.drone_sn) }}</span>
+            <span v-if="m.pilot"> &#183; {{ m.pilot }}</span>
+            &#183; {{ $t('Checklist {0}/{1}', m.checklist.filter(c => c.done).length, m.checklist.length) }}
+          </div>
+
+          <div v-if="openId === m.id" class="detail">
+            <div v-if="m.notes" class="notes">{{ m.notes }}</div>
+            <div class="label">{{ $t('Routes') }}</div>
+            <div v-if="!m.wayline_ids.length" class="hint">{{ $t('No route assigned') }}</div>
+            <div v-for="id in m.wayline_ids" :key="id" class="route">
+              <a @click="showRoute(id)"><AimOutlined /> {{ routeName(id) }}</a>
+            </div>
+            <div class="label">{{ $t('Checklist') }}</div>
+            <div v-for="c in m.checklist" :key="c.key" class="check">
+              <a-checkbox :checked="c.done" :disabled="m.status === 'evaluated' || m.status === 'cancelled'"
+                          @change="(e) => check(m, c.key, e.target.checked)">{{ c.label }}</a-checkbox>
+              <span v-if="c.done && c.by" class="by">{{ c.by }}, {{ fmtTime(c.at, true) }}</span>
+            </div>
+            <div class="actions">
+              <a-button v-for="s in nextStatus[m.status]" :key="s" size="small" @click="setStatus(m, s)">
+                {{ $t(actionText[s]) }}
+              </a-button>
+              <a-button size="small" @click="openForm(m)">{{ $t('Edit') }}</a-button>
+              <a-popconfirm :title="$t('Delete this mission?')" :ok-text="$t('Delete')" :cancel-text="$t('Cancel')"
+                            @confirm="remove(m)">
+                <a-button size="small" danger>{{ $t('Delete') }}</a-button>
+              </a-popconfirm>
+            </div>
+            <div class="hint">{{ $t('Remote start is only possible with a DJI Dock: open the route in Pilot 2 on the remote controller and start it there.') }}</div>
+          </div>
+        </div>
+      </div>
+    </div>
+
+    <a-modal v-model:visible="formVisible" :title="editing ? $t('Edit mission') : $t('New mission')" :confirm-loading="saving"
+             :ok-text="$t('Save')" :ok-button-props="{ disabled: !form.title.trim() || !form.start }" width="560px" @ok="save">
+      <a-form layout="vertical">
+        <a-form-item :label="$t('Title')">
+          <a-input v-model:value="form.title" :maxlength="120" :placeholder="$t('e.g. PV roof barn')" />
+        </a-form-item>
+        <div class="two">
+          <a-form-item :label="$t('Purpose')">
+            <a-select v-model:value="form.purpose">
+              <a-select-option v-for="(label, key) in options.purposes" :key="key" :value="key">{{ label }}</a-select-option>
+            </a-select>
+          </a-form-item>
+          <a-form-item :label="$t('Site')">
+            <a-input v-model:value="form.site" :maxlength="120" />
+          </a-form-item>
+        </div>
+        <div class="two">
+          <a-form-item :label="$t('Date and time')">
+            <a-date-picker v-model:value="form.start" show-time format="DD.MM.YYYY HH:mm" :minute-step="5" style="width: 100%" />
+          </a-form-item>
+          <a-form-item :label="$t('Duration (min)')">
+            <a-input-number v-model:value="form.duration_min" :min="1" :max="1440" style="width: 100%" />
+          </a-form-item>
+        </div>
+        <div class="two">
+          <a-form-item :label="$t('Drone')">
+            <a-select v-model:value="form.drone_sn" allow-clear>
+              <a-select-option v-for="d in options.drones" :key="d.sn" :value="d.sn">{{ d.name }}</a-select-option>
+            </a-select>
+          </a-form-item>
+          <a-form-item :label="$t('Pilot')">
+            <a-select v-model:value="form.pilot" allow-clear>
+              <a-select-option v-for="p in options.pilots" :key="p" :value="p">{{ p }}</a-select-option>
+            </a-select>
+          </a-form-item>
+        </div>
+        <a-form-item :label="$t('Routes')">
+          <a-select v-model:value="form.wayline_ids" mode="multiple" :filter-option="filterRoute" :placeholder="$t('Routes from the library')">
+            <a-select-option v-for="r in options.routes" :key="r.id" :value="r.id">{{ r.name }}</a-select-option>
+          </a-select>
+        </a-form-item>
+        <a-form-item :label="$t('Notes')">
+          <a-textarea v-model:value="form.notes" :rows="3" :maxlength="4000" />
+        </a-form-item>
+        <div class="hint">{{ $t('The checklist follows the purpose; ticked items are kept when the purpose changes.') }}</div>
+      </a-form>
+    </a-modal>
+  </div>
+</template>
+
+<script lang="ts" setup>
+import { t } from '/@/locales'
+import { computed, onMounted, reactive, ref } from 'vue'
+import { message } from 'ant-design-vue'
+import { AimOutlined, ReloadOutlined } from '@ant-design/icons-vue'
+import moment, { Moment } from 'moment'
+import Title from '/@/components/workspace/Title.vue'
+import {
+  Mission, MissionOptions, MissionPurpose, MissionStatus, STATUS_COLORS, createMission, deleteMission, listMissions,
+  missionOptions, setMissionStatus, tickCheck, updateMission,
+} from '/@/api/missions'
+import { getRouteGeometry } from '/@/api/mapping'
+import { useRouteOverlay } from '/@/hooks/use-route-overlay'
+
+const missions = ref<Mission[]>([])
+const options = ref<MissionOptions>({ purposes: {} as any, drones: [], pilots: [], routes: [] })
+const openId = ref<string | null>(null)
+const formVisible = ref(false)
+const saving = ref(false)
+const editing = ref<Mission | null>(null)
+const form = reactive({
+  title: '', purpose: 'pv' as MissionPurpose, start: null as Moment | null, duration_min: 30 as number | null,
+  site: '', notes: '', drone_sn: undefined as string | undefined, pilot: undefined as string | undefined,
+  wayline_ids: [] as string[],
+})
+const routeOverlay = useRouteOverlay()
+
+const statusText: Record<MissionStatus, string> = {
+  planned: 'planned', ready: 'ready', flown: 'flown', evaluated: 'evaluated', cancelled: 'cancelled',
+}
+const actionText: Record<string, string> = {
+  flown: 'Mark as flown', evaluated: 'Mark as evaluated', cancelled: 'Cancel mission', planned: 'Plan again', ready: 'Ready',
+}
+// manual transitions offered as buttons (planned <-> ready follows the checklist)
+const nextStatus: Record<MissionStatus, MissionStatus[]> = {
+  planned: ['flown', 'cancelled'], ready: ['flown', 'cancelled'], flown: ['evaluated'], evaluated: ['flown'], cancelled: ['planned'],
+}
+
+const groups = computed(() => {
+  const startToday = moment().startOf('day')
+  const endToday = moment().endOf('day')
+  const items = [...missions.value]
+  return [
+    { key: 'today', label: 'Today', items: items.filter(m => moment(m.planned_start).isBetween(startToday, endToday, undefined, '[]')) },
+    { key: 'upcoming', label: 'Upcoming', items: items.filter(m => moment(m.planned_start).isAfter(endToday)) },
+    {
+      key: 'past',
+      label: 'Past (30 days)',
+      items: items.filter(m => moment(m.planned_start).isBefore(startToday)).reverse(),
+    },
+  ]
+})
+
+function fmtTime (iso: string | null, withDate: boolean): string {
+  if (!iso) return ''
+  return moment(iso).format(withDate ? 'DD.MM. HH:mm' : 'HH:mm')
+}
+function droneName (sn: string) { return options.value.drones.find(d => d.sn === sn)?.name || sn }
+function routeName (id: string) { return options.value.routes.find(r => r.id === id)?.name || t('deleted route') }
+function filterRoute (input: string, option: any) {
+  return String(option.children?.[0]?.children || '').toLowerCase().includes(input.toLowerCase())
+}
+function errorText (e: any): string {
+  const d = e?.response?.data?.detail
+  return Array.isArray(d) ? d.map((x: any) => x.msg).join('; ') : (d || String(e))
+}
+
+async function refresh () {
+  try {
+    const [opts, list] = await Promise.all([
+      missionOptions(),
+      listMissions({ start: moment().subtract(30, 'days').startOf('day').toISOString() }),
+    ])
+    options.value = opts
+    missions.value = list
+  } catch (e) {
+    message.error(t('Mapping service not reachable'))
+  }
+}
+
+function replace (m: Mission) {
+  missions.value = missions.value.map(x => (x.id === m.id ? m : x))
+}
+
+function toggle (m: Mission) {
+  openId.value = openId.value === m.id ? null : m.id
+  if (openId.value && m.wayline_ids.length) showRoute(m.wayline_ids[0])
+}
+
+async function showRoute (id: string) {
+  try {
+    routeOverlay.show(await getRouteGeometry(id))
+  } catch (e) {
+    message.error(t('Route cannot be shown: mapping service not reachable or file unreadable'))
+  }
+}
+
+async function check (m: Mission, key: string, done: boolean) {
+  try {
+    replace(await tickCheck(m.id, key, done))
+  } catch (e) {
+    message.error(t('Saving failed: ') + errorText(e))
+  }
+}
+
+async function setStatus (m: Mission, s: MissionStatus) {
+  try {
+    replace(await setMissionStatus(m.id, s))
+  } catch (e) {
+    message.error(t('Saving failed: ') + errorText(e))
+  }
+}
+
+async function remove (m: Mission) {
+  try {
+    await deleteMission(m.id)
+    missions.value = missions.value.filter(x => x.id !== m.id)
+    routeOverlay.clear()
+  } catch (e) {
+    message.error(t('Deleting failed: ') + errorText(e))
+  }
+}
+
+function openForm (m?: Mission) {
+  editing.value = m || null
+  Object.assign(form, m
+    ? {
+        title: m.title, purpose: m.purpose, start: moment(m.planned_start), duration_min: m.duration_min, site: m.site,
+        notes: m.notes, drone_sn: m.drone_sn || undefined, pilot: m.pilot || undefined, wayline_ids: [...m.wayline_ids],
+      }
+    : {
+        title: '', purpose: 'pv', start: moment().add(1, 'day').hour(12).minute(0).second(0), duration_min: 30, site: '',
+        notes: '', drone_sn: undefined, pilot: undefined, wayline_ids: [],
+      })
+  formVisible.value = true
+}
+
+async function save () {
+  saving.value = true
+  const body = {
+    title: form.title.trim(), purpose: form.purpose, planned_start: (form.start as Moment).toISOString(),
+    duration_min: form.duration_min || null, site: form.site.trim(), notes: form.notes, drone_sn: form.drone_sn || null,
+    pilot: form.pilot || null, wayline_ids: form.wayline_ids,
+  }
+  try {
+    const m = editing.value ? await updateMission(editing.value.id, body) : await createMission(body)
+    if (editing.value) replace(m)
+    else missions.value = [...missions.value, m].sort((a, b) => a.planned_start.localeCompare(b.planned_start))
+    formVisible.value = false
+    openId.value = m.id
+    message.success(t('Mission saved'))
+  } catch (e) {
+    message.error(t('Saving failed: ') + errorText(e))
+  } finally {
+    saving.value = false
+  }
+}
+
+onMounted(refresh)
+</script>
