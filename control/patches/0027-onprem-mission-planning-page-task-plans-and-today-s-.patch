+<template>
+  <div v-if="missions.length" class="pilot-missions">
+    <div class="mb5"><span class="ml5" style="color: #939393;">{{ $t('My missions today') }}</span></div>
+    <div v-for="m in missions" :key="m.id" class="card">
+      <div class="row" @click="openId = openId === m.id ? null : m.id">
+        <span class="time">{{ time(m.planned_start) }}</span>
+        <span class="name">{{ m.title }}</span>
+        <a-tag :color="STATUS_COLORS[m.status]">{{ $t(m.status) }}</a-tag>
+      </div>
+      <div class="meta">{{ m.purpose_label }}<span v-if="m.site"> &#183; {{ m.site }}</span>
+        &#183; {{ $t('Checklist {0}/{1}', m.checklist.filter(c => c.done).length, m.checklist.length) }}</div>
+      <div v-if="openId === m.id" class="detail">
+        <div v-if="m.notes" class="notes">{{ m.notes }}</div>
+        <div class="hint">{{ $t('Routes are in the Pilot 2 route library (cloud sync).') }}</div>
+        <div v-for="c in m.checklist" :key="c.key" class="check">
+          <a-checkbox :checked="c.done" :disabled="m.status === 'evaluated' || m.status === 'cancelled'"
+                      @change="(e) => check(m, c.key, e.target.checked)">{{ c.label }}</a-checkbox>
+        </div>
+        <a-button v-if="m.status === 'planned' || m.status === 'ready'" size="large" type="primary" block class="flown"
+                  @click="flown(m)">{{ $t('Mark as flown') }}</a-button>
+      </div>
+    </div>
+  </div>
+</template>
+
+<script lang="ts" setup>
+// onprem: missions of the logged-in pilot for today on the remote controller (Pilot 2 cloud page)
+import { onMounted, ref } from 'vue'
+import { message } from 'ant-design-vue'
+import moment from 'moment'
+import { t } from '/@/locales'
+import { Mission, STATUS_COLORS, listMissions, setMissionStatus, tickCheck } from '/@/api/missions'
+
+const missions = ref<Mission[]>([])
+const openId = ref<string | null>(null)
+
+function time (iso: string) { return moment(iso).format('HH:mm') }
+
+async function load () {
+  try {
+    missions.value = await listMissions({
+      start: moment().startOf('day').toISOString(), end: moment().endOf('day').toISOString(), mine: true,
+    })
+    if (missions.value.length === 1) openId.value = missions.value[0].id
+  } catch (e) {
+    missions.value = []                      // no mission service: the page works without this section
+  }
+}
+
+function replace (m: Mission) { missions.value = missions.value.map(x => (x.id === m.id ? m : x)) }
+
+async function check (m: Mission, key: string, done: boolean) {
+  try { replace(await tickCheck(m.id, key, done)) } catch (e) { message.error(t('Saving failed: ') + String(e)) }
+}
+
+async function flown (m: Mission) {
+  try { replace(await setMissionStatus(m.id, 'flown')) } catch (e) { message.error(t('Saving failed: ') + String(e)) }
+}
+
+onMounted(load)
+</script>
+
+<style lang="scss" scoped>
+.pilot-missions { margin-bottom: 10px; }
+.card { background: white; border-radius: 4px; padding: 10px 12px; margin-bottom: 6px; }
+.row { display: flex; align-items: center; gap: 10px; font-size: 16px;
+  .time { font-weight: 600; color: #2d8cf0; } .name { flex: 1; } }
+.meta { color: #939393; font-size: 13px; margin-top: 2px; }
+.detail { margin-top: 8px; .notes { white-space: pre-wrap; margin-bottom: 6px; } .hint { color: #939393; font-size: 12px; margin-bottom: 6px; }
+  .check { padding: 6px 0; border-bottom: 1px solid #f4f8f9; font-size: 15px; } .flown { margin-top: 10px; } }
+</style>
