diff --git a/src/api/farming.ts b/src/api/farming.ts
index 0ac9f18..6f4a70a 100644
--- a/src/api/farming.ts
+++ b/src/api/farming.ts
@@ -69,3 +69,27 @@ export async function deleteZoneMap (id: string): Promise<void> {
 export function exportUrl (id: string, format: ExportFormat): string {
   return `${farmingBase()}/api/farming/zonemaps/${id}/export/${format}?token=${encodeURIComponent(authToken())}`
 }
+
+// Mavic 3M NDVI quick look per shot, computed in the background from the band TIFFs (farming multispectral.py)
+export interface MsPreview {
+  capture: string
+  index: 'NDVI'
+  bands_present: string[]
+  objects: Record<string, string> // band -> object key
+  grid_scale: number
+  stats: { valid_fraction: number, mean?: number, median?: number, p05?: number, p95?: number }
+  irradiance: Record<string, number>
+  calibration: string
+  error?: string
+}
+
+// object key of a media file -> preview of its shot (null: not a M3M band or not computed yet)
+export async function getMsPreviews (keys: string[]): Promise<Record<string, MsPreview | null>> {
+  if (!keys.length) return {}
+  return (await http.post('/api/farming/ms-preview/objects', { keys })).data
+}
+
+// <img src>: the token goes into the query string
+export function msPreviewPngUrl (capture: string): string {
+  return `${farmingBase()}/api/farming/ms-preview/${capture}.png?token=${encodeURIComponent(authToken())}`
+}
diff --git a/src/components/MediaPanel.vue b/src/components/MediaPanel.vue
index f84a033..492bddb 100644
--- a/src/components/MediaPanel.vue
+++ b/src/components/MediaPanel.vue
@@ -11,7 +11,13 @@
           </a-tooltip>
         </template>
         <template #preview="{ record }">
-          <img v-if="hasThumbnail(record.file_name)" class="thumb" loading="lazy" :alt="record.file_name"
+          <a-tooltip v-if="ndvi[record.object_key]?.stats?.mean !== undefined" :title="$t('Click for the NDVI preview')">
+            <div class="ndvi-thumb" @click="openNdvi(record)">
+              <img class="thumb" loading="lazy" :alt="record.file_name" :src="msPreviewPngUrl(ndvi[record.object_key].capture)" />
+              <span class="ndvi-badge">NDVI {{ ndvi[record.object_key].stats.mean.toFixed(2) }}</span>
+            </div>
+          </a-tooltip>
+          <img v-else-if="hasThumbnail(record.file_name)" class="thumb" loading="lazy" :alt="record.file_name"
                :src="thumbnailUrl(record.file_id)" />
           <VideoCameraOutlined v-else-if="/\.(mp4|mov)$/i.test(record.file_name)" class="fz20" />
         </template>
@@ -48,6 +54,26 @@
       </a-table>
     </div>
   </a-spin>
+  <a-modal v-model:visible="ndviModal.visible" :title="$t('NDVI preview (Mavic 3M)')" :footer="null" width="760px">
+    <template v-if="ndviModal.preview">
+      <img class="ndvi-large" :alt="ndviModal.fileName" :src="msPreviewPngUrl(ndviModal.preview.capture)" />
+      <div class="ndvi-legend">
+        <span>-0.2</span><div class="ndvi-ramp"></div><span>0.9</span>
+      </div>
+      <a-descriptions size="small" :column="2" bordered>
+        <a-descriptions-item :label="$t('Mean')">{{ fixed(ndviModal.preview.stats.mean, 3) }}</a-descriptions-item>
+        <a-descriptions-item :label="$t('Median')">{{ fixed(ndviModal.preview.stats.median, 3) }}</a-descriptions-item>
+        <a-descriptions-item label="p5 - p95">{{ fixed(ndviModal.preview.stats.p05, 2) }} - {{ fixed(ndviModal.preview.stats.p95, 2) }}</a-descriptions-item>
+        <a-descriptions-item :label="$t('valid pixels')">{{ (ndviModal.preview.stats.valid_fraction * 100).toFixed(1) }} %</a-descriptions-item>
+        <a-descriptions-item :label="$t('Bands')">{{ ndviModal.preview.bands_present.join(', ') }}</a-descriptions-item>
+        <a-descriptions-item :label="$t('Sunlight sensor')">
+          {{ Object.entries(ndviModal.preview.irradiance).map(([b, v]) => `${b} ${v.toFixed(0)}`).join(' \u00b7 ') }}
+        </a-descriptions-item>
+        <a-descriptions-item :label="$t('Shot')" :span="2">{{ ndviModal.fileName.replace(/_MS_\w+\.TIF$/i, '') }}</a-descriptions-item>
+      </a-descriptions>
+      <p class="ndvi-note">{{ $t('Quick look without orthomosaic: reflectance-calibrated, bands aligned, lens distortion not removed.') }}</p>
+    </template>
+  </a-modal>
 </template>
 
 <script setup lang="ts">
@@ -61,6 +87,7 @@ import { downloadFile } from '../utils/common'
 import { downloadMediaFile, getMediaFiles } from '/@/api/media'
 import { DownloadOutlined, VideoCameraOutlined } from '@ant-design/icons-vue'
 import { MediaMeta, authToken, getMediaMeta, mappingBase } from '/@/api/mapping'
+import { MsPreview, getMsPreviews, msPreviewPngUrl } from '/@/api/farming'
 
 // onprem: photo parameters (EXIF + DJI XMP) from the mapping service
 function fixed (v: number | null | undefined, digits: number): string {
@@ -180,9 +207,24 @@ interface MediaFile {
   file_path: string,
   create_time: string,
   file_id: string,
+  object_key: string,
   meta?: MediaMeta | null,
 }
 
+// onprem: NDVI quick look of Mavic 3M shots (farming service), shown on the band TIFF rows
+const ndvi = ref<Record<string, MsPreview | null>>({})
+const ndviModal = reactive({ visible: false, fileName: '', preview: null as MsPreview | null })
+function openNdvi (media: MediaFile) {
+  ndviModal.preview = ndvi.value[media.object_key] || null
+  ndviModal.fileName = media.file_name
+  ndviModal.visible = !!ndviModal.preview
+}
+function loadNdvi (files: MediaFile[]) {
+  const keys = files.filter(m => /\.tiff?$/i.test(m.object_key || '')).map(m => m.object_key)
+  getMsPreviews(keys).then(res => { ndvi.value = res })
+    .catch(() => message.warning(t('NDVI preview not available (farming service not reachable)')))
+}
+
 const mediaData = reactive({
   data: [] as MediaFile[]
 })
@@ -196,6 +238,7 @@ function getFiles () {
     mediaData.data = res.data.list
     paginationProp.total = res.data.pagination.total
     paginationProp.current = res.data.pagination.page
+    loadNdvi(mediaData.data)
     getMediaMeta(mediaData.data.map((m: MediaFile) => m.file_id)).then(meta => {
       mediaData.data = mediaData.data.map((m: MediaFile) => ({ ...m, meta: meta[m.file_id] }))
     }).catch(() => message.warning(t('Photo parameters not available (mapping service not reachable)')))
@@ -238,6 +281,22 @@ function downloadMedia (media: MediaFile) {
     border-radius: 2px;
     background: #2a2a2a;
   }
