+}
+.ndvi-legend {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin: 8px 0 12px;
+  font-size: 12px;
+  .ndvi-ramp {
+    flex: 1;
+    height: 10px;
+    border-radius: 2px;
+    background: linear-gradient(to right, rgb(215, 48, 39), rgb(215, 255, 91), rgb(26, 150, 60));
+  }
+}
+.ndvi-note {
+  margin: 12px 0 0;
+  font-size: 12px;
+  color: #888;
+}
 .header {
   width: 100%;
   height: 60px;
