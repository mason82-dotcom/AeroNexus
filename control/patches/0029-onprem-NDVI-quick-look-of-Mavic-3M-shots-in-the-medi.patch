+    left: 2px;
+    bottom: 2px;
+    padding: 0 4px;
+    font-size: 11px;
+    line-height: 16px;
+    color: #fff;
+    background: rgba(0, 0, 0, 0.65);
+    border-radius: 2px;
+  }
   .media-table {
     background: #fff;
     margin-top: 10px;
@@ -247,6 +306,29 @@ function downloadMedia (media: MediaFile) {
     cursor: pointer;
   }
 }
+.ndvi-large {
