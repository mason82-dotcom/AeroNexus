From c051432713b6ecb993fc7f98654190ab8c9f646c Mon Sep 17 00:00:00 2001
From: RomaN <mason82.rm@googlemail.com>
Date: Sat, 3 Oct 2026 02:59:18 +0200
Subject: [PATCH] onprem: route copies and planned routes carry their computed
 flight path (texts, lens)

---
 src/api/mapping.ts                      | 9 ++++++---
 src/components/wayline/RouteEditor.vue  | 2 +-
 src/components/wayline/RoutePlanner.vue | 6 ++++--
 src/locales/de.ts                       | 3 +++
 4 files changed, 14 insertions(+), 6 deletions(-)

diff --git a/src/api/mapping.ts b/src/api/mapping.ts
index 9d815ec..b2eb30c 100644
--- a/src/api/mapping.ts
+++ b/src/api/mapping.ts
@@ -136,6 +136,8 @@ export function layerTileUrl (layer: MappingLayer): string {
 
 // ---- flight routes (wayline library), read and edited copies via the mapping service
 
+export type PlanLens = 'wide' | 'thermal' | 'ms'
+
 export interface RouteParams {
   height: number
   direction: number
@@ -144,10 +146,9 @@ export interface RouteParams {
   overlap_w: number
   speed: number
   image_format?: string | null // thermal cameras: "visable", "ir", "visable,ir"
+  lens?: PlanLens | null // camera that sets lane and photo spacing (default: first camera of the template)
 }
 
-export type PlanLens = 'wide' | 'thermal' | 'ms'
-
 export interface PlanPreset {
   label: string
   lens: PlanLens
@@ -220,6 +221,8 @@ export async function getRouteGeometry (waylineId: string): Promise<RouteGeometr
   return (await http.get(`/api/mapping/waylines/${waylineId}`)).data
 }
 
-export async function copyRoute (waylineId: string, body: { name: string, polygon: [number, number][], params: RouteParams }): Promise<{ id: string, name: string }> {
+export interface RoutePathInfo { waypoints: number, lanes: number, length_m: number, duration_s: number, speed: number, shot_interval_s: number }
+
+export async function copyRoute (waylineId: string, body: { name: string, polygon: [number, number][], params: RouteParams }): Promise<{ id: string, name: string, path: RoutePathInfo | null }> {
   return (await http.post(`/api/mapping/waylines/${waylineId}/copy`, body)).data
 }
diff --git a/src/components/wayline/RouteEditor.vue b/src/components/wayline/RouteEditor.vue
index f7c3146..b261d09 100644
--- a/src/components/wayline/RouteEditor.vue
+++ b/src/components/wayline/RouteEditor.vue
@@ -25,7 +25,7 @@
 
     <template v-else>
       <div class="hint">
-        {{ $t('Drag corners to move them, click a small dot to add a corner, right-click a corner to delete it. The grey line is the old flight path: Pilot 2 recomputes the route from the area when the copy is opened.') }}
+        {{ $t('Drag corners to move them, click a small dot to add a corner, right-click a corner to delete it. The grey line is the old flight path: when saving, AeroNexus computes the new path from area, height, overlap and direction.') }}
       </div>
       <a-form layout="horizontal" :label-col="{ span: 10 }" :wrapper-col="{ span: 14 }" class="form">
         <a-form-item :label="$t('Name of the copy')">
diff --git a/src/components/wayline/RoutePlanner.vue b/src/components/wayline/RoutePlanner.vue
index ac85854..de202a2 100644
--- a/src/components/wayline/RoutePlanner.vue
+++ b/src/components/wayline/RoutePlanner.vue
@@ -7,7 +7,7 @@
     </div>
     <div class="meta">{{ $t('Template') }}: {{ info.name }} ({{ info.camera }})</div>
     <div class="hint">
-      {{ $t('Drag the corners onto the area, click a small dot to add a corner, right-click a corner to delete it. The orange line is a preview; Pilot 2 computes the final route.') }}
+      {{ $t('Drag the corners onto the area, click a small dot to add a corner, right-click a corner to delete it. The orange line is the flight path that is saved with the route.') }}
     </div>
 
     <a-form layout="horizontal" :label-col="{ span: 11 }" :wrapper-col="{ span: 13 }" class="form">
@@ -194,9 +194,11 @@ async function save () {
       params: {
         height: form.height, direction: form.direction % 360, margin: form.margin, overlap_h: form.overlap_h,
         overlap_w: form.overlap_w, speed: form.speed, image_format: info.value!.image_formats.length ? form.image_format : null,
+        lens: form.lens,
       },
     })
-    message.success(t('Saved as new route "{0}". Pilot 2 syncs it into its library.', result.name))
+    message.success(t('Saved as new route "{0}". Pilot 2 syncs it into its library.', result.name) +
+      (result.path ? ' ' + t('{0} lanes, {1} min, photo every {2} s.', result.path.lanes, Math.ceil(result.path.duration_s / 60), result.path.shot_interval_s) : ''), 8)
     close()
     emit('saved')
   } catch (e: any) {
diff --git a/src/locales/de.ts b/src/locales/de.ts
index 816c94d..09ebc68 100644
--- a/src/locales/de.ts
+++ b/src/locales/de.ts
@@ -621,4 +621,7 @@ export default {
   "Visible photo (frame approximate)": "Normalbild (Rahmen ungefähr)",
   "PDF report": "PDF-Bericht",
   "HTML report": "HTML-Bericht",
+  "Drag the corners onto the area, click a small dot to add a corner, right-click a corner to delete it. The orange line is the flight path that is saved with the route.": "Ecken auf die Fläche ziehen, kleiner Punkt fügt eine Ecke hinzu, Rechtsklick löscht eine Ecke. Die orange Linie ist die Flugbahn, die mit der Route gespeichert wird.",
+  "Drag corners to move them, click a small dot to add a corner, right-click a corner to delete it. The grey line is the old flight path: when saving, AeroNexus computes the new path from area, height, overlap and direction.": "Ecken ziehen zum Verschieben, auf einen kleinen Punkt klicken fügt eine Ecke hinzu, Rechtsklick auf eine Ecke löscht sie. Die graue Linie ist die alte Flugbahn: Beim Speichern berechnet AeroNexus die neue Bahn aus Fläche, Höhe, Überlappung und Richtung.",
+  "{0} lanes, {1} min, photo every {2} s.": "{0} Bahnen, {1} min, Foto alle {2} s.",
 } as Record<string, string>
-- 
