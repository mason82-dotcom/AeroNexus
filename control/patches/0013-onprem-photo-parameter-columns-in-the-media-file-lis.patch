From d99299fa865c5e9986c6915746a4e7b278b4f820 Mon Sep 17 00:00:00 2001
From: aeronexus <aeronexus@local>
Date: Fri, 2 Oct 2026 18:11:28 +0200
Subject: [PATCH] onprem: photo parameter columns in the media file list

Captured time, camera/resolution/exposure, GNSS status + heights, gimbal and
laser range, file size; read from EXIF/DJI XMP by the mapping service.
---
 src/api/mapping.ts            | 31 ++++++++++++++
 src/components/MediaPanel.vue | 79 ++++++++++++++++++++++++++++++++++-
 2 files changed, 108 insertions(+), 2 deletions(-)

diff --git a/src/api/mapping.ts b/src/api/mapping.ts
index d23214d..b7d5587 100644
--- a/src/api/mapping.ts
+++ b/src/api/mapping.ts
@@ -90,6 +90,37 @@ export async function getMappingLayers (): Promise<MappingLayer[]> {
   return (await http.get('/api/mapping/layers')).data
 }
 
+export interface MediaMeta {
+  captured: string | null // local camera time, ISO without zone
+  model: string | null
+  width: number | null
+  height: number | null
+  exposure_time: number | null
+  f_number: number | null
+  iso: number | null
+  focal_mm: number | null
+  focal_35mm: number | null
+  shutter: string | null
+  gps_status: string | null
+  lat: number | null
+  lon: number | null
+  abs_alt: number | null
+  rel_alt: number | null
+  altitude_type: string | null
+  rtk_std_m: number | null
+  gimbal_pitch: number | null
+  gimbal_yaw: number | null
+  flight_yaw: number | null
+  lrf_distance: number | null
+  size_bytes: number | null
+  error?: string
+}
+
+export async function getMediaMeta (fileIds: string[]): Promise<Record<string, MediaMeta | null>> {
+  if (!fileIds.length) return {}
+  return (await http.post('/api/mapping/media/meta', { file_ids: fileIds.slice(0, 200) })).data
+}
+
 // Leaflet loads tiles via <img>, so the token goes into the query string
 export function layerTileUrl (layer: MappingLayer): string {
   return mappingBase() + layer.tile_url + '?token=' + encodeURIComponent(authToken())
diff --git a/src/components/MediaPanel.vue b/src/components/MediaPanel.vue
index a984add..ef3804a 100644
--- a/src/components/MediaPanel.vue
+++ b/src/components/MediaPanel.vue
@@ -15,6 +15,29 @@
                :src="thumbnailUrl(record.file_id)" />
           <VideoCameraOutlined v-else-if="/\.(mp4|mov)$/i.test(record.file_name)" class="fz20" />
         </template>
+        <template #captured="{ record }">{{ record.meta?.captured ? record.meta.captured.replace('T', ' ') : '' }}</template>
+        <template #camera="{ record }">
+          <template v-if="record.meta && !record.meta.error">
+            <div>{{ record.meta.model }} <span class="dim">{{ megapixel(record.meta) }}</span></div>
+            <div class="dim">{{ exposure(record.meta) }}</div>
+          </template>
+        </template>
+        <template #position="{ record }">
+          <template v-if="record.meta && !record.meta.error">
+            <a-tooltip :title="record.meta.lat !== null ? `${record.meta.lat.toFixed(7)}, ${record.meta.lon.toFixed(7)}` : 'no valid GNSS position'">
+              <a-tag :color="gnssColor(record.meta.gps_status)">{{ record.meta.gps_status || '-' }}</a-tag>
