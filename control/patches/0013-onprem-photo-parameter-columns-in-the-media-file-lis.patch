         <template #original="{ text }">
           {{ text }}
         </template>
@@ -37,7 +60,27 @@ import { ELocalStorageKey } from '../types/enums'
 import { downloadFile } from '../utils/common'
 import { downloadMediaFile, getMediaFiles } from '/@/api/media'
 import { DownloadOutlined, VideoCameraOutlined } from '@ant-design/icons-vue'
-import { authToken, mappingBase } from '/@/api/mapping'
+import { MediaMeta, authToken, getMediaMeta, mappingBase } from '/@/api/mapping'
+
+// onprem: photo parameters (EXIF + DJI XMP) from the mapping service
+function fixed (v: number | null | undefined, digits: number): string {
+  return v === null || v === undefined ? '-' : v.toFixed(digits)
+}
+function megapixel (m: MediaMeta): string {
+  return m.width && m.height ? `${m.width}x${m.height} (${(m.width * m.height / 1e6).toFixed(1)} MP)` : ''
+}
+function exposure (m: MediaMeta): string {
+  const parts: string[] = []
+  if (m.exposure_time) parts.push(m.exposure_time >= 1 ? `${m.exposure_time} s` : `1/${Math.round(1 / m.exposure_time)} s`)
+  if (m.f_number) parts.push(`f/${m.f_number}`)
+  if (m.iso) parts.push(`ISO ${m.iso}`)
+  if (m.focal_35mm) parts.push(`${m.focal_35mm} mm`)
+  if (m.shutter) parts.push(m.shutter === 'Mechanical' ? 'mech.' : 'elec.')
+  return parts.join(' \u00b7 ')
+}
+function gnssColor (status: string | null): string {
+  return status === 'RTK' ? 'green' : (status === 'Invalid' || !status ? 'default' : 'blue')
+}
 
 // onprem: thumbnails are rendered and cached by the mapping service (JPEG incl. thermal, 16-bit TIF)
 function hasThumbnail (fileName: string): boolean {
