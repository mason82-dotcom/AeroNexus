+// AeroNexus Photovoltaik service (thermal inspections of PV plants). Same login token as the DJI backend.
+import axios from 'axios'
+import { CURRENT_CONFIG } from '/@/api/http/config'
+import { authToken } from '/@/api/mapping'
+import { ELocalStorageKey } from '/@/types/enums'
+
+export type AnomalyStatus = 'open' | 'confirmed' | 'dismissed'
+export type PvExport = 'report' | 'csv' | 'geojson'
+
+export interface Anomaly {
+  id: string
+  number: number
+  klass: 1 | 2 | 3
+  delta: number
+  t_max: number
+  t_background: number
+  type: string
+  area_m2: number | null
+  lat: number | null
+  lon: number | null
+  height_source: string | null
+  file_name: string
+  seen_in: string[]
+  status: AnomalyStatus
+  note: string
+  has_crop: boolean
+}
+
+export interface InspectionImage {
+  file_id: string
+  file_name: string
+  anomalies: number
+  skipped?: string
+  model?: string
+  gps?: boolean
+  height_m?: number
+  height_source?: string
+  t_min?: number
+  t_max?: number
+}
+
+export interface ThermalParams { emissivity: number, reflected_temp: number, humidity: number }
+export interface DetectParams { min_delta: number, class1: number, class2: number, class3: number }
+
+export interface Inspection {
+  id: string
+  name: string
+  created_at: string
+  created_by: string
+  status: 'queued' | 'running' | 'done' | 'failed'
+  progress: number
+  error?: string | null
+  image_count: number
+  params: { thermal: ThermalParams, detect: DetectParams, merge_m: number }
+  summary?: { images: number, analysed: number, anomalies: number, by_class: Record<string, number>, without_position: number }
+  images?: InspectionImage[]
+  anomalies?: Anomaly[]
+}
+
+export function pvBase (): string {
+  return CURRENT_CONFIG.pvURL.replace(/\/+$/, '')
+}
+
+const http = axios.create({ timeout: 60000 })
+http.interceptors.request.use(config => {
+  config.baseURL = pvBase()
+  config.headers[ELocalStorageKey.Token] = authToken()
+  return config
+})
+
+export async function pvStatus (): Promise<{ tsdk: boolean, queue: number }> {
+  return (await http.get('/api/pv/status')).data
+}
+
+export async function listInspections (): Promise<Inspection[]> {
+  return (await http.get('/api/pv/inspections')).data
+}
+
+export async function getInspection (id: string): Promise<Inspection> {
+  return (await http.get(`/api/pv/inspections/${id}`)).data
+}
+
+export async function createInspection (body: {
+  name: string, file_ids: string[], thermal: Partial<ThermalParams>, detect: Partial<DetectParams>, merge_m: number
+}): Promise<Inspection> {
+  return (await http.post('/api/pv/inspections', body)).data
+}
+
+export async function updateAnomaly (id: string, aid: string, body: { status?: AnomalyStatus, note?: string }): Promise<Anomaly> {
+  return (await http.put(`/api/pv/inspections/${id}/anomalies/${aid}`, body)).data
+}
+
+export async function deleteInspection (id: string): Promise<void> {
+  await http.delete(`/api/pv/inspections/${id}`)
+}
+
+// <img>/<a href> cannot send headers: login token as query parameter (never logged by the service)
+export function cropUrl (id: string, aid: string): string {
+  return `${pvBase()}/api/pv/inspections/${id}/crops/${aid}.png?token=${encodeURIComponent(authToken())}`
+}
+
+export function exportUrl (id: string, fmt: PvExport): string {
+  return `${pvBase()}/api/pv/inspections/${id}/export/${fmt}?token=${encodeURIComponent(authToken())}`
+}
