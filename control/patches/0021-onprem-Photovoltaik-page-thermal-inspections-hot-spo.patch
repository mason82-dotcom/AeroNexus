+                <a-input-number v-model:value="form.detect.class2" :min="1" :max="100" class="small" />
+                <a-input-number v-model:value="form.detect.class3" :min="1" :max="100" class="small" />
+              </a-form-item>
+              <a-form-item :label="$t('Merge radius (m)')" :title="$t('The same fault in overlapping images is reported once')">
+                <a-input-number v-model:value="form.merge_m" :min="0" :max="20" :step="0.5" />
+              </a-form-item>
+            </div>
+          </a-collapse-panel>
+        </a-collapse>
+        <div class="hint">{{ $t('Meaningful results need irradiance above 600 W/m2, clear sky and modules under load.') }}</div>
+      </a-form>
+    </a-modal>
+  </div>
+</template>
+
+<script lang="ts" setup>
+import { t } from '/@/locales'
+import { computed, onMounted, onUnmounted, reactive, ref, watch } from 'vue'
+import { message } from 'ant-design-vue'
+import { DeleteOutlined, ReloadOutlined } from '@ant-design/icons-vue'
+import Title from '/@/components/workspace/Title.vue'
+import { MappingMedia, getMappingMedia } from '/@/api/mapping'
+import {
+  Anomaly, AnomalyStatus, Inspection, createInspection, cropUrl, deleteInspection, exportUrl, getInspection,
+  listInspections, pvStatus, updateAnomaly,
+} from '/@/api/pv'
+import { CLASS_COLORS, clearAnomalies, focusAnomaly, showAnomalies } from '/@/hooks/use-pv-overlay'
+
+const inspections = ref<Inspection[]>([])
+const current = ref<Inspection | null>(null)
+const selected = ref<Anomaly | null>(null)
+const noteDraft = ref('')
+const tsdk = ref<boolean | null>(null)
+const tableVisible = ref(false)
+const createVisible = ref(false)
+const creating = ref(false)
+const media = ref<MappingMedia[]>([])
+const mediaLoading = ref(false)
+const classFilter = ref<number[]>([1, 2, 3])
+const showDismissed = ref(false)
+const form = reactive({
+  name: '', ids: [] as string[], merge_m: 1.0,
+  thermal: { emissivity: 0.85, reflected_temp: 23, humidity: 70 },
+  detect: { min_delta: 3, class1: 3, class2: 10, class3: 20 },
+})
+
+const statusColor: Record<string, string> = { queued: 'default', running: 'processing', done: 'success', failed: 'error' }
+const statusText: Record<string, string> = {
+  queued: 'queued', running: 'running', done: 'done', failed: 'failed', open: 'open', confirmed: 'confirmed', dismissed: 'dismissed',
+}
+const classText: Record<number, string> = { 1: 'observe', 2: 'plan maintenance', 3: 'urgent' }
+const classOptions = [
+  { label: t('Class 3'), value: 3 }, { label: t('Class 2'), value: 2 }, { label: t('Class 1'), value: 1 },
+]
+const mediaColumns = [
+  { title: t('File'), dataIndex: 'file_name', ellipsis: true },
+  { title: t('Camera'), dataIndex: 'payload', width: 150, ellipsis: true },
+  { title: t('Time (UTC)'), dataIndex: 'create_time', width: 170, customRender: ({ text }: { text: string }) => text.replace('T', ' ').replace('Z', '') },
+]
+const tableColumns = [
+  { title: t('No.'), dataIndex: 'number', width: 60, sorter: (a: Anomaly, b: Anomaly) => a.number - b.number },
+  { title: t('Image'), width: 130, slots: { customRender: 'crop' } },
+  { title: t('Class'), width: 70, slots: { customRender: 'klass' }, sorter: (a: Anomaly, b: Anomaly) => a.klass - b.klass },
+  { title: t('Delta-T (K)'), dataIndex: 'delta', width: 80, sorter: (a: Anomaly, b: Anomaly) => a.delta - b.delta },
+  { title: t('T max (deg C)'), dataIndex: 't_max', width: 90 },
+  { title: t('Type (estimate)'), width: 210, slots: { customRender: 'type' } },
+  { title: t('Status'), width: 100, slots: { customRender: 'status' } },
+  { title: t('Note'), dataIndex: 'note', ellipsis: true },
+]
+
+// DJI thermal photos end with _T (M3T/M4T R-JPEG)
+const thermalMedia = computed(() => media.value.filter(m => /_T\.jpe?g$/i.test(m.file_name)))
+const days = computed(() => [...new Set(thermalMedia.value.map(m => m.create_time.slice(0, 10)))].slice(0, 6))
+const canCreate = computed(() => form.ids.length > 0)
+const visibleAnomalies = computed(() => (current.value?.anomalies || [])
+  .filter(a => classFilter.value.includes(a.klass) && (showDismissed.value || a.status !== 'dismissed')))
+
+function errorText (e: any): string {
+  const detail = e?.response?.data?.detail
+  return typeof detail === 'string' ? detail : (detail ? JSON.stringify(detail) : String(e))
+}
+
+async function refresh () {
+  try {
+    inspections.value = await listInspections()
+    tsdk.value = (await pvStatus()).tsdk
+    if (current.value) {
+      const fresh = inspections.value.find(i => i.id === current.value?.id)
+      if (!fresh) close()
+      else if (fresh.status !== current.value.status) await open(fresh)
+    }
+  } catch (e) {
+    message.error(t('Photovoltaics service not reachable: ') + errorText(e))
+  }
+}
+
+async function open (ins: Inspection) {
+  current.value = await getInspection(ins.id)
+  selected.value = null
+  redraw(true)
+}
+
+function redraw (fit = false) {
+  if (current.value?.status === 'done') showAnomalies(visibleAnomalies.value, select, fit)
+  else clearAnomalies()
+}
+
+function close () {
+  current.value = null
+  selected.value = null
+  clearAnomalies()
+}
+
+function select (a: Anomaly) {
+  selected.value = a
+  noteDraft.value = a.note
+  focusAnomaly(a)
+}
+
+async function setStatus (a: Anomaly, status: AnomalyStatus) {
+  try {
+    Object.assign(a, await updateAnomaly(current.value!.id, a.id, { status }))
+    redraw()
+  } catch (e) {
+    message.error(t('Saving failed: ') + errorText(e))
+  }
+}
+
+async function saveNote () {
+  const a = selected.value!
+  try {
+    Object.assign(a, await updateAnomaly(current.value!.id, a.id, { note: noteDraft.value }))
+    message.success(t('Note saved'))
+  } catch (e) {
+    message.error(t('Saving failed: ') + errorText(e))
+  }
+}
+
+async function remove (ins: Inspection) {
+  try {
+    await deleteInspection(ins.id)
+    if (current.value?.id === ins.id) close()
+    message.success(t('Inspection "{0}" deleted', ins.name))
+  } catch (e) {
+    message.error(t('Deleting failed: ') + errorText(e))
+  }
+  await refresh()
+}
+
+async function openCreate () {
+  createVisible.value = true
+  mediaLoading.value = true
+  try {
+    media.value = (await getMappingMedia(1, 500)).list
+  } catch (e) {
+    message.error(t('Mapping service not reachable'))
+  } finally {
+    mediaLoading.value = false
+  }
+}
+
+async function submit () {
+  creating.value = true
+  try {
+    const ins = await createInspection({ name: form.name, file_ids: form.ids, thermal: form.thermal, detect: form.detect, merge_m: form.merge_m })
+    createVisible.value = false
+    form.ids = []
+    form.name = ''
+    message.success(t('Inspection queued'))
+    await refresh()
+    await open(ins)
+  } catch (e) {
+    message.error(t('Starting the inspection failed: ') + errorText(e))
+  } finally {
+    creating.value = false
+  }
+}
+
+watch([classFilter, showDismissed], () => redraw())
+
+let timer: number | undefined
+onMounted(() => {
+  refresh()
+  // progress of running inspections
+  timer = window.setInterval(() => {
+    if (inspections.value.some(i => i.status === 'queued' || i.status === 'running')) refresh()
+  }, 3000)
+})
+onUnmounted(() => {
+  window.clearInterval(timer)
+  clearAnomalies()
+})
+</script>
+
+<style lang="scss" scoped>
+.pv-wrapper { display: flex; flex-direction: column; }
+.pv-content { flex: 1; overflow-y: auto; padding: 0 12px 12px; color: #fff; }
+.alert { margin: 8px 0; }
