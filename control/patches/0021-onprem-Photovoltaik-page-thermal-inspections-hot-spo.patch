diff --git a/src/hooks/use-pv-overlay.ts b/src/hooks/use-pv-overlay.ts
new file mode 100644
index 0000000..21d4dfb
--- /dev/null
+++ b/src/hooks/use-pv-overlay.ts
@@ -0,0 +1,44 @@
+// Anomalies of one PV inspection as circle markers on the shared Leaflet map (colour = class).
+import L from 'leaflet'
+import { getRoot } from '/@/root'
+import { Anomaly } from '/@/api/pv'
+
+export const CLASS_COLORS: Record<number, string> = { 1: '#fadb14', 2: '#fa8c16', 3: '#f5222d' }
+let overlay: L.FeatureGroup | null = null
+const markers: Record<string, L.CircleMarker> = {}
+
+function map (): L.Map | undefined {
+  return getRoot()?.$map?.leaflet
+}
+
+export function showAnomalies (items: Anomaly[], onClick: (a: Anomaly) => void, fit = true) {
+  clearAnomalies()
+  const m = map()
+  if (!m) return
+  overlay = L.featureGroup().addTo(m)
+  items.filter(a => a.lat !== null && a.lon !== null).forEach(a => {
+    const dismissed = a.status === 'dismissed'
+    const mk = L.circleMarker([a.lat as number, a.lon as number], {
+      radius: 7 + a.klass, color: dismissed ? '#888' : '#000', weight: 1,
+      fillColor: dismissed ? '#bbb' : CLASS_COLORS[a.klass], fillOpacity: dismissed ? 0.4 : 0.9,
+    }).bindTooltip(`#${a.number}: ${a.delta.toFixed(1)} K`)
+    mk.on('click', () => onClick(a))
+    mk.addTo(overlay as L.FeatureGroup)
+    markers[a.id] = mk
+  })
+  if (fit && overlay.getLayers().length) m.fitBounds(overlay.getBounds(), { padding: [40, 40], maxZoom: 20 })
+}
+
+export function focusAnomaly (a: Anomaly) {
+  const m = map()
+  const mk = markers[a.id]
+  if (!m || !mk) return
+  m.setView(mk.getLatLng(), Math.max(m.getZoom(), 19))
+  mk.openTooltip()
+}
+
+export function clearAnomalies () {
+  overlay?.remove()
+  overlay = null
+  Object.keys(markers).forEach(k => delete markers[k])
+}
