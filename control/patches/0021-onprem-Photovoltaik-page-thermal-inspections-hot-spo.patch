+.filters { margin: 6px 0; :deep(.ant-checkbox-wrapper) { color: #ddd; font-size: 12px; } }
+.anomaly { padding: 4px 6px; cursor: pointer; font-size: 13px; border-radius: 3px;
+  &:hover, &.selected { background: #2d3442; } &.dismissed { opacity: 0.5; }
+  .type { color: #aaa; font-size: 12px; margin-left: 6px; } .st { margin-left: 6px; } }
+.exports { display: flex; gap: 10px; margin-top: 10px; flex-wrap: wrap; .label { color: #888; font-size: 12px; } }
+.crop { width: 100%; margin-bottom: 10px; image-rendering: pixelated; }
+.thumb { width: 110px; image-rendering: pixelated; }
+.facts { width: 100%; font-size: 13px; td { padding: 3px 4px; vertical-align: top; } td:first-child { color: #888; width: 110px; } }
+.status { margin: 10px 0; }
+.save { margin-top: 6px; }
+.media-tools { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 6px; }
+.params { display: grid; grid-template-columns: 1fr 1fr; column-gap: 16px; .small { width: 70px; margin-right: 6px; } }
+.danger { color: #ff4d4f; }
+</style>
