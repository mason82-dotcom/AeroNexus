         RedisOpsUtils.hashSet(RedisConst.LIVE_CAPACITY, deviceSn, capacity);
     }
 
+    private static <T> Predicate<T> distinctBy(Function<T, Object> key) {
+        Set<Object> seen = new HashSet<>();
+        return t -> seen.add(key.apply(t));
+    }
+
     public CapacityCameraDTO receiver2Dto(CapacityCameraReceiver receiver) {
         CapacityCameraDTO.CapacityCameraDTOBuilder builder = CapacityCameraDTO.builder();
         if (receiver == null) {
@@ -66,6 +75,8 @@ public class CapacityCameraServiceImpl implements ICapacityCameraService {
                 .id(UUID.randomUUID().toString())
                 .videosList(receiver.getVideoList()
                         .stream()
+                        // M3M reports its multispectral bands as identical "multi-spectral-0" entries
+                        .filter(distinctBy(video -> String.valueOf(video.getVideoIndex())))
                         .map(cameraVideoService::receiver2Dto)
                         .filter(Objects::nonNull)
                         .collect(Collectors.toList()))
