 @Configuration
 public class StateRouter {
 
+    private static final Logger log = LoggerFactory.getLogger(StateRouter.class);
+
+    private static final Set<String> IGNORED_STATE_KEYS = ConcurrentHashMap.newKeySet();
+
     @Resource
     private MqttGatewayPublish gatewayPublish;
 
@@ -40,6 +47,7 @@ public class StateRouter {
     public IntegrationFlow stateDataRouterFlow() {
         return IntegrationFlows
                 .from(ChannelName.INBOUND_STATE)
+                .filter(Message.class, this::isKnownState)
                 .transform(Message.class, source -> {
                     try {
                         TopicStateRequest response = Common.getObjectMapper().readValue((byte[]) source.getPayload(), new TypeReference<TopicStateRequest>() {});
@@ -75,6 +83,25 @@ public class StateRouter {
     }
 
 
+    /**
+     * Newer Pilot 2 / RC firmware reports state keys this SDK does not model yet
+     * (e.g. wpmz_version, is_cloud_control_auth, camera_watermark_settings).
+     * Drop them with one warning per key instead of failing the whole flow.
+     */
+    private boolean isKnownState(Message<?> source) {
+        try {
+            TopicStateRequest request = Common.getObjectMapper().readValue((byte[]) source.getPayload(), new TypeReference<TopicStateRequest>() {});
+            getTypeReference(request.getGateway(), request.getData());
+            return true;
+        } catch (CloudSDKException | IOException e) {
+            String key = e.getMessage();
+            if (IGNORED_STATE_KEYS.add(key)) {
+                log.warn("Ignoring unsupported state data: {} (topic {})", key, source.getHeaders().get(MqttHeaders.RECEIVED_TOPIC));
+            }
+            return false;
+        }
+    }
+
     private Class getTypeReference(String gatewaySn, Object data) {
         Set<String> keys = ((Map<String, Object>) data).keySet();
         switch (SDKManager.getDeviceSDK(gatewaySn).getType()) {
