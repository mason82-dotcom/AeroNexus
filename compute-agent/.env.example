# AeroNexus compute agent - copy to .env (gitignored) and fill in.

# Mapping service on the Pi (edge stack), port 6790
PI_URL=http://192.168.178.63:6790
# Same value as MAPPING_AGENT_TOKEN in edge/.env on the Pi
MAPPING_AGENT_TOKEN=change-me-mapping-agent
# Name of this node as shown in the web UI (A-Z a-z 0-9 . _ -)
AGENT_ID=x64-werkstatt
# Token between agent and NodeODM (random, only used inside this stack)
NODEODM_TOKEN=change-me-nodeodm

# Largest job this node accepts. ODM minimum RAM: 16 GB ~ 250 images, 32 GB ~ 500, 64 GB ~ 1500.
MAX_IMAGES=200
# CRS of the delivered orthophoto/DSM COGs (tiles are always web mercator)
TARGET_CRS=EPSG:25832
LEASE_SECONDS=600
POLL_SECONDS=20
