# ---------------------------------------------------------------------------
# AeroNexus Edge - copy to .env and fill in. .env is gitignored.
# ---------------------------------------------------------------------------

# LAN IP or DNS name of the server. Handed to DJI Pilot 2 for MQTT, S3 uploads,
# RTMP and the web page -> must be reachable FROM THE REMOTE CONTROLLER.
SERVER_HOST=192.168.178.40

# DJI Developer -> "Cloud API" app (https://developer.dji.com/user/apps)
DJI_APP_ID=
DJI_APP_KEY=
DJI_APP_LICENSE=

# Workspace shown in Pilot 2
WORKSPACE_NAME="Roman Flotte"
PLATFORM_NAME="AeroNexus"
WORKSPACE_BIND_CODE=change-me

# Logins (replace upstream defaults adminPC/adminPC and pilot/pilot123)
WEB_ADMIN_PASSWORD=change-me-admin
PILOT_LOGIN_PASSWORD=change-me-pilot
# Second Pilot 2 login, e.g. for the DJI RC Plus 2 (Matrice 4); own MQTT user below
PILOT2_LOGIN_USER=pilot2
PILOT2_LOGIN_PASSWORD=change-me-pilot2

# MySQL / Redis / JWT
MYSQL_ROOT_PASSWORD=change-me-mysql
REDIS_PASSWORD=change-me-redis
JWT_SECRET=change-me-to-a-long-random-string

# EMQX (built-in auth, bootstrapped from these values)
MQTT_SERVER_USER=onprem-backend
MQTT_SERVER_PASSWORD=change-me-mqtt-backend
MQTT_PILOT_USER=pilot
MQTT_PILOT_PASSWORD=change-me-mqtt-pilot
MQTT_PILOT2_USER=pilot2
MQTT_PILOT2_PASSWORD=change-me-mqtt-pilot2
EMQX_DASHBOARD_PASSWORD=change-me-emqx

# MinIO (root = admin only; STS user = what the backend uses for AssumeRole)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-root
MINIO_STS_USER=djiupload
MINIO_STS_PASSWORD=change-me-minio-sts
MINIO_BUCKET=dji-cloud

# Livestream (MediaMTX, checked by the mapping service)
# Publish login of Pilot 2: part of the RTMP URL the backend hands to the RC (letters/digits only)
LIVE_PUBLISH_USER=pilot2cloud
LIVE_PUBLISH_PASSWORD=change-me-live-publish
# Reader login for VLC / RTSP (rtsp://viewer:<pw>@<SERVER_HOST>:8554/live/<stream>)
RTSP_USER=viewer
RTSP_PASSWORD=change-me-rtsp

# Misc
NTP_SERVER=ptbtime1.ptb.de
LOG_LEVEL=info

# Web map (Leaflet). Center as "lng,lat", zoom 1-20.
MAP_CENTER=10.45,51.16
MAP_ZOOM=6
# Tile server. Default is the public OSM server (fine for occasional private use).
# For heavier use or offline operation point this to your own tile server.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Offline vector basemap (default layer when set): ../mapping-tool/basemaps/fetch-basemap.sh [region]
# Path on the web UI host; leave empty to use the online tiles only.
MAP_PMTILES_URL=/basemaps/baden-wuerttemberg.pmtiles
# Offline aerial images (LGL BW DOP20, open data): ../mapping-tool/basemaps/fetch-orthophoto.sh [name] [radius_km]
MAP_ORTHO_PMTILES_URL=/basemaps/luftbild-home.pmtiles

# Home point "lon,lat" (WGS84). Test tools place simulated geodata only within 10 km of it.
HOME_POINT=10.45,51.16

# Mapping tool (mapping-tool/service, see mapping-tool/docs/adr-001-architektur.md)
# Shared secret of the x64 compute agent (Authorization: Bearer ...)
MAPPING_AGENT_TOKEN=change-me-mapping-agent
# Lifetime of presigned MinIO URLs for the agent (input images, result uploads), <= 3600
PRESIGN_TTL_SECONDS=3600
# MinIO user of the mapping service: read media bucket, read/write mapping-results and basemaps
# MySQL user 'mapping' (own database 'mapping', read-only on two DJI tables), created by mapping-db-init
MAPPING_DB_PASSWORD=change-me-mapping-db
MAPPING_MINIO_USER=mapping
MAPPING_MINIO_PASSWORD=change-me-minio-mapping
# Farming Guide service: MinIO user (read mapping-results, read/write bucket 'farming')
FARMING_MINIO_USER=farming
FARMING_MINIO_PASSWORD=change-me-minio-farming
# Photovoltaik Tool: MinIO user (read Pilot 2 uploads, read/write bucket 'pv-inspections')
PV_MINIO_USER=pvtool
PV_MINIO_PASSWORD=change-me-minio-pv
# Wake-on-LAN of the x64 node (phase 2, optional; leave WOL_MAC empty to disable)
WOL_MAC=
WOL_BROADCAST=192.168.178.255

# Backup (edge/backup.sh, edge/restore.sh). Target should NOT be the SD card / disk holding edge/data.
BACKUP_DIR=/mnt/hc4backup/aeronexus
BACKUP_KEEP_DAYS=14
