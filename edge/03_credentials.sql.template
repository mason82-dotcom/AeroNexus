-- onprem: replace upstream default logins (adminPC/adminPC, pilot/pilot123).
-- Rendered by setup.sh from .env into sql/03_onprem_credentials.sql (gitignored).
USE `cloud_sample`;
UPDATE `manage_user` SET `password` = '${WEB_ADMIN_PASSWORD}',   `mqtt_username` = '${MQTT_PILOT_USER}', `mqtt_password` = '${MQTT_PILOT_PASSWORD}' WHERE `username` = 'adminPC';
UPDATE `manage_user` SET `password` = '${PILOT_LOGIN_PASSWORD}', `mqtt_username` = '${MQTT_PILOT_USER}', `mqtt_password` = '${MQTT_PILOT_PASSWORD}' WHERE `username` = 'pilot';
UPDATE `manage_workspace` SET `workspace_name` = '${WORKSPACE_NAME}', `platform_name` = '${PLATFORM_NAME}', `bind_code` = '${WORKSPACE_BIND_CODE}';
-- second Pilot 2 login (e.g. DJI RC Plus 2). Fixed user_id so re-running is idempotent.
INSERT INTO `manage_user` (`user_id`, `username`, `password`, `workspace_id`, `user_type`, `mqtt_username`, `mqtt_password`, `create_time`, `update_time`)
SELECT 'b2c4e6a8-0002-4c00-8a00-a3e0a3e0a302', '${PILOT2_LOGIN_USER}', '${PILOT2_LOGIN_PASSWORD}', `workspace_id`, 2, '${MQTT_PILOT2_USER}', '${MQTT_PILOT2_PASSWORD}',
       UNIX_TIMESTAMP() * 1000, UNIX_TIMESTAMP() * 1000 FROM `manage_workspace` LIMIT 1
ON DUPLICATE KEY UPDATE `username` = VALUES(`username`), `password` = VALUES(`password`),
       `mqtt_username` = VALUES(`mqtt_username`), `mqtt_password` = VALUES(`mqtt_password`), `update_time` = VALUES(`update_time`);
